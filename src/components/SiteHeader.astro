---
import { site, nav } from '../data/site';
import IconTelefon from './IconTelefon.astro';

const pfad = Astro.url.pathname;
const aktiv = (href: string) => pfad === href || pfad.startsWith(href + '/');

/* Siehe Base.astro: im Vorschau-Build liegt die Seite in einem Unterordner. */
const basis = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<header class="kopfleiste">
  <div class="wrap balken">
    <a href="/" class="marke" aria-label={`${site.name} — zur Startseite`}>
      <img class="bildmarke" src={`${basis}cc-logo.png`} alt="" width="2070" height="384" />
    </a>

    <nav class="haupt" aria-label="Hauptnavigation">
      <ul>
        {nav.map((n) => (
          <li>
            <a href={n.href} aria-current={aktiv(n.href) ? 'page' : undefined}>{n.text}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="rechts">
      <a class="ruf" href={`tel:${site.telefonLink}`}>
        <IconTelefon groesse={18} />
        {site.telefon}
      </a>
      <a class="btn" href="/anfrage">Angebot anfordern</a>
      <button class="schalter" type="button" aria-expanded="false" aria-controls="mobilmenue" aria-label="Menü öffnen">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobilmenue" id="mobilmenue" hidden>
    <div class="wrap">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.text}</a></li>)}
        <li><a href="/kontakt">Kontakt</a></li>
      </ul>
    </div>
  </div>
</header>

{/* Schwebender Anrufknopf, nur mobil. Er ersetzt die frühere Rufleiste mit
    „Anrufen“ und „Angebot anfordern“: Auf der Startseite taucht er erst auf,
    wenn die beiden Knöpfe im Auftakt (data-ruf-anker) aus dem Bild gescrollt
    sind; auf Seiten ohne solchen Anker steht er von Anfang an da. */}
<a class="rufknopf" href={`tel:${site.telefonLink}`} aria-label={`Anrufen: ${site.telefon}`} data-sichtbar="false">
  <IconTelefon groesse={26} />
</a>

<style>
  /* Durchgehender Balken über die volle Seitenbreite. Die Fläche sitzt auf der
     Kopfleiste selbst, der Inhalt bleibt im .wrap — dadurch stehen Bildmarke
     und Aktionen auf derselben Achse wie der Text der Seite darunter. */
  .kopfleiste {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 0;
    background: oklch(100% 0 0 / 0.88);
    backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid var(--linie);
  }

  .balken {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    padding-block: 0.6875rem;
  }

  /* Lockup: plastisches Zeichen, daneben der Schriftzug. Beide über die Höhe
     skaliert, damit sie bei jeder Breite zueinander passen. */
  /* Ein geschlossenes Logo statt Zeichen und Schriftzug einzeln: Abstand und
     Groessenverhaeltnis stecken jetzt in der Datei, nicht im CSS. */
  .marke { display: flex; align-items: center; flex: none; line-height: 0; }
  .marke .bildmarke { width: auto; height: 34px; }

  /* Zentriert sich im Platz zwischen Bildmarke und Aktionen. Das ist nicht
     exakt die Seitenmitte — die rechte Gruppe ist breiter als die Bildmarke.
     Erzwungen gleiche Randspalten gingen bei 1280px nicht auf: dort blieben je
     275px, die rechte Gruppe braucht mit Telefonnummer aber 319px. */
  .haupt { margin-inline: auto; }
  .haupt ul { display: flex; align-items: center; gap: 0.125rem; list-style: none; }
  .haupt a {
    display: block;
    padding: 0.5rem 0.875rem;
    /* Zweiwortige Punkte wie „Über uns“ bleiben auch bei knapper Breite einzeilig. */
    white-space: nowrap;
    border-radius: var(--r-pill);
    font-size: 0.9375rem;
    font-weight: 480;
    text-decoration: none;
    color: var(--ink-2);
    transition: color 0.15s var(--ease), background 0.15s var(--ease);
  }
  /* Kein Pillenhintergrund, weder bei Hover noch beim aktiven Punkt — die
     Kennzeichnung läuft allein über Farbe und Schriftschnitt. Der Radius bleibt
     stehen, damit der Tastaturfokus weiterhin rund umrandet wird. */
  .haupt a:hover { color: var(--ink); }
  .haupt a[aria-current='page'] { color: var(--blau); font-weight: 560; }

  /* nowrap: der Knopf soll nie zweizeilig werden, wenn der Platz knapp wird. */
  .rechts { display: flex; align-items: center; gap: var(--s-3); flex: none; white-space: nowrap; }

  /* Die Aktion in der Kopfleiste ist kleiner als die Aktionen im Inhalt — sie
     begleitet nur und soll den schmalen Balken nicht dominieren. */
  .rechts .btn {
    padding: 0.5625rem 1.0625rem;
    font-size: 0.875rem;
  }

  .ruf {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    font-family: var(--font);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    padding: 0.5rem 0.25rem;
    white-space: nowrap;
  }
  /* Das Symbol tritt etwas zurück, damit die Nummer die Hauptsache bleibt. */
  .ruf :global(svg) { color: var(--blau); flex: none; }
  .ruf:hover { color: var(--blau); }

  .schalter {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 0 11px;
    background: var(--feld);
    border: 0;
    border-radius: var(--r-pill);
    cursor: pointer;
  }
  .schalter span {
    display: block;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.25s var(--ease);
  }
  .schalter[aria-expanded='true'] span:nth-child(1) { transform: translateY(3.25px) rotate(45deg); }
  .schalter[aria-expanded='true'] span:nth-child(2) { transform: translateY(-3.25px) rotate(-45deg); }

  /* Klappt als volle Breite unter dem Balken auf, passend zur neuen Kopfform. */
  .mobilmenue {
    padding-block: var(--s-4) var(--s-5);
    background: var(--panel);
    border-top: 1px solid var(--linie);
    box-shadow: var(--schwebe-2);
  }
  .mobilmenue[hidden] { display: none; }
  .mobilmenue ul { list-style: none; }
  .mobilmenue li + li { border-top: 1px solid var(--linie); }
  .mobilmenue a {
    display: block;
    padding: 0.875rem 0.25rem;
    font-family: var(--font);
    font-size: 1.0625rem;
    font-weight: 520;
    text-decoration: none;
  }
  .rufknopf {
    display: none;
    position: fixed;
    right: calc(1rem + env(safe-area-inset-right));
    bottom: calc(1rem + env(safe-area-inset-bottom));
    z-index: 60;
    width: 3.5rem;
    height: 3.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--blau);
    color: #fff;
    box-shadow: var(--schwebe-2);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
  }
  /* Hörer gespiegelt: die Muschel zeigt nach rechts oben statt nach links. */
  .rufknopf :global(svg) { transform: scaleX(-1); }
  .rufknopf:active { background: var(--blau-tief); }
  .rufknopf[data-sichtbar='false'] {
    opacity: 0;
    transform: scale(0.85);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .rufknopf { transition: none; }
  }

  /* Unterhalb von 1200px reicht der Balken nicht mehr für Bildmarke, Navigation,
     Telefonnummer und Knopf nebeneinander — gemessen braucht die Zeile dort
     1172px. Statt dass die Navigation umbricht oder die Seite quer scrollt,
     weicht zuerst die Nummer; erreichbar bleibt sie über Fußzeile und Kontakt. */
  @media (max-width: 75rem) {
    .ruf { display: none; }
  }

  @media (max-width: 64rem) {
    .haupt, .ruf, .rechts .btn { display: none; }
    .schalter { display: flex; }
    .rechts { margin-inline-start: auto; }
    .rufknopf { display: flex; }
  }
</style>

<script>
  /*
    Die Hoehe der Kopfleiste steht als --kopf-h in den Tokens, damit der Auftakt
    auf der Startseite genau den Rest des Bildschirms fuellen kann. Fest
    eingetragene 65px stimmen aber nur zufaellig: Schriftgroesse, Symbolgroesse
    und Geraeteaufloesung verschieben die tatsaechliche Hoehe um Bruchteile
    eines Punktes — und genau dieser Rest blieb unten als heller Streifen
    stehen. Deshalb wird der Wert hier gemessen und nachgetragen.
  */
  const kopfleiste = document.querySelector('.kopfleiste');
  if (kopfleiste) {
    const hoeheSetzen = () => {
      const h = kopfleiste.getBoundingClientRect().height;
      document.documentElement.style.setProperty('--kopf-h', `${h}px`);
    };
    hoeheSetzen();
    new ResizeObserver(hoeheSetzen).observe(kopfleiste);
  }

  const schalter = document.querySelector<HTMLButtonElement>('.schalter');
  const menue = document.getElementById('mobilmenue');
  schalter?.addEventListener('click', () => {
    const offen = schalter.getAttribute('aria-expanded') === 'true';
    schalter.setAttribute('aria-expanded', String(!offen));
    schalter.setAttribute('aria-label', offen ? 'Menü öffnen' : 'Menü schließen');
    if (menue) menue.hidden = offen;
  });

  const rufknopf = document.querySelector<HTMLElement>('.rufknopf');
  const anker = document.querySelector('[data-ruf-anker]');
  if (rufknopf && anker) {
    // Sichtbar erst, wenn die Knöpfe oben aus dem Bild gerutscht sind.
    new IntersectionObserver(([e]) => {
      const vorbei = !e.isIntersecting && e.boundingClientRect.top < 0;
      rufknopf.dataset.sichtbar = String(vorbei);
    }).observe(anker);
  } else if (rufknopf) {
    rufknopf.dataset.sichtbar = 'true';
  }
</script>
