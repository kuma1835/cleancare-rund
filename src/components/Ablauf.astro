---
import { ablauf } from '../data/site';
---

<section class="abschnitt">
  <div class="wrap">
    <div class="panel ablauf-panel">
      <div class="ablauf-kopf">
        <p class="label">So läuft es</p>
        <h2>In drei Schritten zum Angebot</h2>
        <p class="lead">
          Kein Formularmarathon, keine Warteschleife. Der Besichtigungstermin ist der Punkt, an dem
          aus Flächen ein belastbarer Preis wird.
        </p>
      </div>

      <ol class="schritte">
        {ablauf.map((s, i) => (
          <li>
            <span class="nummer">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.titel}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .ablauf-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: clamp(1.75rem, 1rem + 3vw, 4rem);
    align-items: start;
  }

  .ablauf-kopf .label { display: block; margin-bottom: var(--s-3); }
  .ablauf-kopf h2 { margin-bottom: var(--s-4); }

  .schritte {
    list-style: none;
    display: grid;
    gap: var(--s-3);
  }

  .schritte li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0 var(--s-4);
    padding: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    background: var(--panel-2);
    border: 1px solid var(--linie);
    border-radius: var(--r-karte);
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .schritte li:hover { background: var(--panel); border-color: var(--linie-2); }

  .nummer {
    grid-row: span 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-klein);
    background: var(--blau-sanft);
    color: var(--blau);
    font-family: var(--font);
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .schritte h3 { margin: 0 0 0.375rem; }
  .schritte p { margin: 0; font-size: 0.9375rem; color: var(--ink-2); line-height: 1.55; }

  @media (max-width: 60rem) {
    .ablauf-panel { grid-template-columns: 1fr; }
  }
  @media (max-width: 34rem) {
    .schritte li { grid-template-columns: 1fr; gap: var(--s-3); }
    .nummer { grid-row: auto; }
  }
</style>
