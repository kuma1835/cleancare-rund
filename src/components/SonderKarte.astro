---
/**
 * Das sechste Feld neben den fünf Hauptleistungen: Fassade, Dach und Solar
 * gesammelt. Der bestehende Auftritt führt sie als „Sonderreinigungen" mit je
 * einem Satz auf der Startseite — deshalb hier ein Feld statt drei Karten.
 *
 * Anders als die Leistungskarte ist dieses Feld selbst kein Link: Es enthält
 * drei eigene Verweise, und ein a im a wäre ungültiges HTML.
 *
 * Erwartet ein <ul> als Elternteil; das Raster bringt die jeweilige Seite mit.
 */
import { Image } from 'astro:assets';
import { sonderleistungen } from '../data/leistungen';
/* Zwei Arbeiter auf einer Hebebühne an der Fassade — das einzige Motiv im
   Bestand, das Arbeit am Gebäude von außen zeigt und damit alle drei
   Sonderreinigungen abdeckt. Es gehört im Datensatz der Fassadenreinigung, die
   auf der Übersicht keine eigene Karte mehr hat. */
import sonderBild from '../assets/img/priscilla-du-preez-budd1hgco-4-unsplash.webp';

interface Props {
  /** Passt die Fläche an die Umgebung an — wie bei der Leistungskarte. */
  variante?: 'bild' | 'kompakt';
  /** Wie breit das Feld im jeweiligen Raster wird — steuert die Bildauswahl. */
  sizes?: string;
}
const { variante = 'kompakt', sizes = '(max-width: 40rem) 45vw, 15rem' } = Astro.props;

const verweise = sonderleistungen.map((l) => ({ name: l.name, href: `/leistungen/${l.slug}` }));
---

<li class={`sonderfeld v-${variante}`}>
  {variante === 'bild' ? (
    <>
      <div class="wort">
        <h3>Sonderreinigungen</h3>
        <ul class="liste">
          {verweise.map((v) => (
            <li>
              <a href={v.href}>
                {v.name}
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h13m-5.5-5.5L18.5 12l-6 5.5" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="medium">
        <Image
          src={sonderBild}
          alt="Zwei Reinigungskräfte auf einer Hebebühne an der Glasfassade eines Bürogebäudes"
          widths={[240, 400, 640]}
          sizes={sizes}
          loading="lazy"
        />
      </div>
    </>
  ) : (
    <>
      <span class="symbol" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 21h18M6 21V10l6-5 6 5v11M10 21v-5h4v5" />
        </svg>
      </span>
      <h3>Sonderreinigungen</h3>
      <ul class="liste">
        {verweise.map((v) => (
          <li>
            <a href={v.href}>
              {v.name}
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h13m-5.5-5.5L18.5 12l-6 5.5" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}
</li>

<style>
  .sonderfeld {
    display: grid;
    height: 100%;
    border: 1px solid var(--linie);
    border-radius: var(--r-karte);
  }

  /* Dieselbe Flächenlogik wie bei der Leistungskarte: auf der Startseite steht
     das Feld auf dem Seitengrund und ist weiß, auf der Übersicht liegt es in
     einem weißen Panel und ist deshalb abgetönt. */
  .v-kompakt { background: var(--panel); }
  .v-bild { background: var(--panel-2); }

  h3 {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.25;
  }

  .liste {
    list-style: none;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.5rem;
    margin: var(--s-3) 0 0;
    padding: 0;
  }

  .liste a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--blau);
    text-decoration: none;
  }
  .liste a svg { flex: none; transition: transform 0.25s var(--ease); }
  .liste a:hover svg { transform: translateX(3px); }
  .liste a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* ---------- Kompakte Fassung (Startseite) ---------- */

  .v-kompakt {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto 1fr;
    justify-items: start;
    gap: var(--s-3);
    padding: var(--s-5);
  }

  .symbol {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-pill);
    background: var(--blau-sanft);
    color: var(--blau);
  }

  /* ---------- Bildfassung (Leistungsübersicht) ---------- */

  /* Aufbau wie bei der Leistungskarte: Text links, Bild rechts bis an die
     Kante. Deshalb trägt das Feld selbst keinen Innenabstand, sondern nur der
     Textteil, und `overflow: hidden` schneidet das Bild auf den Radius. */
  .v-bild {
    grid-template-columns: minmax(0, 1fr) minmax(0, 42%);
    align-items: stretch;
    overflow: hidden;
  }
  .v-bild .wort {
    display: grid;
    align-content: start;
    padding: var(--s-5);
  }

  .medium {
    position: relative;
    min-height: 11.5rem;
    background: var(--blau-nebel);
  }
  .medium :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Auf schmalen Geräten steht das Bild unter dem Text — wie bei der Karte. */
  @media (max-width: 34rem) {
    .v-bild { grid-template-columns: 1fr; }
    .medium { min-height: 9rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .liste a:hover svg { transform: none; }
  }
</style>
