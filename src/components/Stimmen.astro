---
import { stimmen, site } from '../data/site';

/**
 * Laufband: die Karten wandern langsam von rechts nach links, an beiden Rändern
 * verblassend. Die Liste wird einmal dupliziert, damit der Lauf ohne Sprung
 * umbricht — die Kopie ist für Screenreader ausgeblendet.
 */
const lauf = [...stimmen, ...stimmen];
---

<section class="abschnitt">
  <div class="wrap">
    <div class="kopfzeile">
      <p class="label">Kundenstimmen</p>
      <h2>Was unsere Kundinnen und Kunden schreiben</h2>
      <p class="lead">
        Nachzulesen im ProvenExpert-Profil. Wörtlich zitiert, nichts gekürzt.
      </p>
    </div>
  </div>

  <div class="laufband">
    <ul class="bahn">
      {lauf.map((s, i) => (
        <li aria-hidden={i >= stimmen.length ? 'true' : undefined}>
          <figure>
            <div class="sterne" role="img" aria-label={`${s.sterne} von 5 Sternen`}>
              {Array.from({ length: s.sterne }).map(() => (
                <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M12 2.6l2.7 5.9 6.4.7-4.8 4.3 1.3 6.3L12 16.6l-5.6 3.2 1.3-6.3-4.8-4.3 6.4-.7z"
                  />
                </svg>
              ))}
            </div>
            <blockquote><p>{s.text}</p></blockquote>
            <figcaption>
              <span class="wer">{s.name}</span>
              <span class="quelle">ProvenExpert</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>

  <div class="wrap">
    <p class="alle">
      <a href={site.provenexpert} rel="noopener">
        Alle Bewertungen bei ProvenExpert
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h13M13 6l6 6-6 6" />
        </svg>
      </a>
    </p>
  </div>
</section>

<style>
  .kopfzeile { margin-bottom: clamp(1.75rem, 1.25rem + 2vw, 2.75rem); }
  .kopfzeile .label { display: block; margin-bottom: var(--s-3); }
  .kopfzeile h2 { margin-bottom: var(--s-4); }

  /* Das Band läuft über die volle Breite und verblasst an beiden Rändern. */
  .laufband {
    overflow: hidden;
    padding-block: 0.5rem;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 12%,
      #000 88%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 12%,
      #000 88%,
      transparent 100%
    );
  }

  .bahn {
    list-style: none;
    display: flex;
    gap: var(--s-4);
    width: max-content;
    animation: wandern 90s linear infinite;
  }
  .laufband:hover .bahn { animation-play-state: paused; }

  @keyframes wandern {
    from { transform: translate3d(0, 0, 0); }
    /* Die halbe Strecke entspricht genau einem Durchlauf der echten Liste. */
    to { transform: translate3d(calc(-50% - var(--s-4) / 2), 0, 0); }
  }

  .bahn li { flex: 0 0 auto; width: clamp(17rem, 24vw, 22rem); }

  figure {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: clamp(1.25rem, 1rem + 1.2vw, 1.75rem);
    background: var(--panel);
    border-radius: var(--r-karte);
    box-shadow: var(--schwebe-1);
  }

  .sterne {
    display: flex;
    gap: 0.1875rem;
    color: var(--blau);
  }

  blockquote { margin: 0; flex: 1; }
  blockquote p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: none;
  }
  blockquote p::before { content: '„'; }
  blockquote p::after { content: '“'; }

  figcaption {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid var(--linie);
  }
  .wer {
    font-family: var(--font);
    font-size: 0.9375rem;
    font-weight: 560;
    color: var(--ink);
  }
  .quelle { font-size: 0.8125rem; color: var(--ink-3); }

  .alle { margin-top: var(--s-5); }
  .alle a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--blau);
    font-family: var(--font);
    font-size: 0.9375rem;
    font-weight: 540;
    text-decoration: none;
  }
  .alle a:hover { text-decoration: underline; }

  /* Ohne Bewegung: Band steht still und lässt sich von Hand schieben. */
  @media (prefers-reduced-motion: reduce) {
    .bahn { animation: none; }
    .laufband { overflow-x: auto; }
  }

  @media (max-width: 52rem) {
    .bahn li { width: min(78vw, 20rem); }
    .bahn { animation-duration: 70s; }
  }
</style>
