---
import { stimmen } from '../data/site';

/**
 * Laufband: die Karten wandern langsam von rechts nach links, an beiden Rändern
 * verblassend. Die Liste wird einmal dupliziert, damit der Lauf ohne Sprung
 * umbricht — die Kopie ist für Screenreader ausgeblendet.
 */
const lauf = [...stimmen, ...stimmen];
---

<section class="abschnitt">
  <div class="wrap">
    <div class="kopfzeile">
      <p class="label">Kundenstimmen</p>
      <h2>Was unsere Kundinnen und Kunden schreiben</h2>
      {/* „Zuverlässig" steht in drei der sieben Zitate und ist damit das
          häufigste Wort — nachgezählt, nicht behauptet. */}
      <p class="lead">
        Ein Wort fällt dabei besonders oft: zuverlässig.
      </p>
    </div>
  </div>

  <div class="wrap">
    <div class="laufband">
      <ul class="bahn">
      {lauf.map((s, i) => (
        <li aria-hidden={i >= stimmen.length ? 'true' : undefined}>
          <figure>
            <blockquote><p>{s.text}</p></blockquote>
            <figcaption>
              <span class="wer">{s.name}</span>
            </figcaption>
          </figure>
        </li>
      ))}
      </ul>
    </div>
  </div>

</section>

<style>
  .kopfzeile {
    margin-bottom: clamp(2.25rem, 1.75rem + 2vw, 3.5rem);
    text-align: center;
  }
  /* `p` bringt aus base.css eine Höchstbreite von 68ch mit. Ohne
     `margin-inline: auto` steht diese Box links im Container und nur ihr
     Text ist darin zentriert — die Marke wirkte dadurch nach links gerückt. */
  .kopfzeile .label { display: block; margin: 0 auto var(--s-3); max-width: none; }
  .kopfzeile h2 { margin-bottom: var(--s-5); max-width: 24ch; margin-inline: auto; }
  .kopfzeile .lead { max-width: var(--mass-mitte); margin-inline: auto; }

  /*
    Das Band steht jetzt im Inhaltsrahmen und endet damit auf derselben Kante
    wie Überschrift, Panels und Fußzeile — vorher lief es über die volle
    Fensterbreite und ragte links und rechts über den Rest der Seite hinaus.
    Der Verlauf setzt entsprechend früher an: die letzte Karte soll innerhalb
    der Seitenbreite ausblenden, nicht erst am Fensterrand.
  */
  .laufband {
    overflow: hidden;
    padding-block: 0.5rem;
    /* Über den Einzug hinaus, damit die Karten die Textachse berühren dürfen. */
    margin-inline: calc(var(--einzug) * -1);
    padding-inline: var(--einzug);
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 7%,
      #000 93%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 7%,
      #000 93%,
      transparent 100%
    );
  }

  .bahn {
    list-style: none;
    display: flex;
    gap: var(--s-4);
    width: max-content;
    animation: wandern 90s linear infinite;
  }
  .laufband:hover .bahn { animation-play-state: paused; }

  @keyframes wandern {
    from { transform: translate3d(0, 0, 0); }
    /* Die halbe Strecke entspricht genau einem Durchlauf der echten Liste. */
    to { transform: translate3d(calc(-50% - var(--s-4) / 2), 0, 0); }
  }

  .bahn li { flex: 0 0 auto; width: clamp(17rem, 24vw, 22rem); }

  figure {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: clamp(1.25rem, 1rem + 1.2vw, 1.75rem);
    background: var(--panel);
    border-radius: var(--r-karte);
    box-shadow: var(--schwebe-1);
  }

  blockquote { margin: 0; flex: 1; }
  blockquote p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: none;
  }
  blockquote p::before { content: '„'; }
  blockquote p::after { content: '“'; }

  figcaption {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid var(--linie);
  }
  .wer {
    font-family: var(--font);
    font-size: 0.9375rem;
    font-weight: 560;
    color: var(--ink);
  }


  /* Ohne Bewegung: Band steht still und lässt sich von Hand schieben. */
  @media (prefers-reduced-motion: reduce) {
    .bahn { animation: none; }
    .laufband { overflow-x: auto; }
  }

  @media (max-width: 52rem) {
    .bahn li { width: min(78vw, 20rem); }
    .bahn { animation-duration: 70s; }
  }
</style>
