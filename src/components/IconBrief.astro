---
/**
 * Briefsymbol für E-Mail-Links — ausgefüllt, passend zum Hörer.
 * Der Umschlag ist eine Fläche, die Lasche ein Loch darin (`evenodd`). Damit
 * bleibt das Symbol auf hellem wie auf dunklem Grund richtig, ohne dass die
 * Lasche in der Hintergrundfarbe nachgezogen werden müsste.
 */
interface Props {
  groesse?: number;
}
const { groesse = 17 } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={groesse}
  height={groesse}
  fill="currentColor"
  fill-rule="evenodd"
  clip-rule="evenodd"
  aria-hidden="true"
>
  <path d="M5.5 5h13A2.5 2.5 0 0 1 21 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 16.5v-9A2.5 2.5 0 0 1 5.5 5Zm-1.2 2.1L12 12.5l7.7-5.4v1.9L12 14.4 4.3 9v-1.9Z" />
</svg>
