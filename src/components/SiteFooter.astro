---
import { site } from '../data/site';
import { leistungen, trennbar } from '../data/leistungen';
import { standorte } from '../data/standorte';

const jahr = new Date().getFullYear();

/*
  Dasselbe Logo wie oben, hier aber einfarbig: in der Fußzeile steht die Marke
  zurück, sie muss dort nicht mehr werben.

  `grayscale` allein reichte nicht — es rechnet jede Farbe in ihre eigene
  Helligkeit um, und weil das Blau des Wirbels heller ist als das Navy der
  Schrift, blieb das Logo zweitönig: heller Wirbel, dunkle Schrift. Deshalb
  erst `brightness(0)`, das alle Bildpunkte auf Schwarz setzt und nur die
  Transparenz stehen lässt, und dann `invert()` als Regler für den Grauwert.
  0.22 trifft das Grau, das die Schrift vorher schon hatte.
*/
const basis = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<footer class="fuss">
  <div class="wrap">
    <div class="fussblatt">
      <div class="spalten">
        <div class="marke-block">
          <a href="/" class="marke" aria-label={`${site.name} — zur Startseite`}>
            <img class="bildmarke" src={`${basis}cc-logo-neu.png`} alt="" width="2070" height="384" />
          </a>
          <p class="satz">
            Ganzheitliche Unterhaltsreinigung für gewerblich genutzte Immobilien in Seevetal, im
            Landkreis Harburg, in Hamburg und in Norddeutschland.
          </p>
          <div class="kontakt">
            <a href={`tel:${site.telefonLink}`} class="mass">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7 2 2 0 0 1 6.5 3.5Z" />
              </svg>
              {site.telefon}
            </a>
            <a href={`mailto:${site.email}`} class="mass">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2.5" />
                <path d="m3.5 7 8.5 6 8.5-6" />
              </svg>
              {site.email}
            </a>
          </div>
        </div>

        <nav aria-label="Leistungen">
          <h2 class="label">Leistungen</h2>
          <ul>
            {leistungen.map((l) => (
              <li><a href={`/leistungen/${l.slug}`}>{trennbar(l.name)}</a></li>
            ))}
          </ul>
        </nav>

        <nav aria-label="Einsatzgebiet">
          <h2 class="label">Einsatzgebiet</h2>
          <ul>
            {standorte.map((s) => (
              <li><a href={`/einsatzgebiet/${s.slug}`}>{s.ort}</a></li>
            ))}
            <li><a href="/einsatzgebiet">Gesamtes Gebiet</a></li>
          </ul>
        </nav>

        <nav aria-label="Unternehmen">
          <h2 class="label">Unternehmen</h2>
          <ul>
            <li><a href="/ueber-uns">Über uns</a></li>
            <li><a href="/faq">Häufige Fragen</a></li>
            <li><a href="/jobs">Jobs</a></li>
            <li><a href="/kontakt">Kontakt</a></li>
            <li><a href="/anfrage">Angebot anfordern</a></li>
            <li><a href={site.linkedin} rel="noopener">LinkedIn</a></li>
            <li><a href={site.provenexpert} rel="noopener">ProvenExpert</a></li>
          </ul>
        </nav>
      </div>

      <div class="leiste">
        <p>© {jahr} {site.name} · Familienunternehmen seit {site.gruendung}</p>
        <ul class="recht">
          <li><a href="/impressum">Impressum</a></li>
          <li><a href="/datenschutz">Datenschutz</a></li>
          <li><a href="/agb">AGB</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Die Fußzeile steht außerhalb von `main` und bekommt dessen Reihenabstand
     nicht mit — der Abstand zum letzten Kasten muss hier selbst stehen.
     Er liegt über der Trennlinie, der Innenabstand darunter; die Linie hat
     damit auf beiden Seiten Luft. */
  .fuss {
    padding-top: var(--reihe);
    /* Unten nur so viel Luft, wie zwischen Trennlinie und Schlusszeile steht
       (--s-5). Der volle Reihenabstand liess darunter eine leere Flaeche
       stehen, durch die man scrollen musste, ohne dass noch etwas kam. */
    padding-bottom: var(--s-5);
  }

  /* Keine eigene Fläche mehr: die Fußzeile liegt direkt auf dem Seitengrund und
     wird nur durch eine feine Linie abgesetzt — dieselbe Machart wie beim
     Kennzahlenblock. Ohne Panel steht ihr Text ohnehin auf der Textachse, der
     Ausgleich über negative Außenabstände entfällt damit. */
  .fussblatt {
    padding-top: clamp(2rem, 1.5rem + 2vw, 3.25rem);
    border-top: 1px solid var(--linie);
  }

  .spalten {
    display: grid;
    grid-template-columns: minmax(16rem, 1.4fr) repeat(3, minmax(8rem, 1fr));
    gap: clamp(1.75rem, 1rem + 3vw, 3.5rem);
  }

  /* Gedämpftes Grau statt Marken-Blau und Navy: in der Fußzeile steht die Marke
     zurück, sie muss dort nicht mehr werben. */
  .marke {
    display: flex;
    align-items: center;
    line-height: 0;
  }
  .marke .bildmarke {
    width: auto;
    height: 32px;
    display: block;
    filter: brightness(0) invert(0.22);
    opacity: 0.75;
  }
  .satz {
    margin-top: var(--s-5);
    font-size: 0.9375rem;
    color: var(--ink-2);
    max-width: 34ch;
  }

  .kontakt { display: grid; justify-items: start; gap: 0.5rem; margin-top: var(--s-5); }
  /* Telefon und E-Mail sind die beiden Aktionen in der Fußzeile — sie tragen
     deshalb die Aktionsfarbe, mit dem jeweiligen Symbol davor. */
  .kontakt a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--blau);
    text-decoration: none;
  }
  .kontakt a svg { flex: none; }
  .kontakt a:hover { text-decoration: underline; }

  .spalten h2 { margin-bottom: var(--s-4); }
  .spalten ul { list-style: none; display: grid; gap: 0.5rem; }
  .spalten nav a {
    font-size: 0.9375rem;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.15s var(--ease);
  }
  .spalten nav a:hover { color: var(--blau); }

  .leiste {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    padding-top: var(--s-5);
    border-top: 1px solid var(--linie);
  }
  .leiste p { margin: 0; font-size: 0.8125rem; color: var(--ink-3); }
  .recht { list-style: none; display: flex; gap: var(--s-4); }
  .recht a { font-size: 0.8125rem; color: var(--ink-3); text-decoration: none; }
  .recht a:hover { color: var(--blau); text-decoration: underline; }

  @media (max-width: 60rem) {
    .spalten { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .marke-block { grid-column: 1 / -1; }
  }
</style>
