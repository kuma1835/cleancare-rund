---
/*
  Kennzahlen-Streifen direkt unter dem Auftakt — Aufbau nach der vom Nutzer
  gesetzten Referenz: heller Band, drei Zahlen nebeneinander, durch feine
  Linien getrennt, rechts ein kurzer Merksatz.

  Alle drei Angaben sind belegt und nicht geschätzt:
  - 15+ Jahre  → Gründung 2009 (site.gruendung), bewusst nach unten gerundet
  - 08         → Anzahl der Einträge in data/leistungen.ts
  - 01         → eine feste Ansprechperson (site.geschaeftsfuehrung)
  Keine Bewertungsnote, keine Mitarbeiterzahl, keine m² — die liegen nicht vor.
  Siehe REDAKTION.md.
*/
import { site } from '../data/site';
import { leistungen } from '../data/leistungen';

const jahre = Math.floor((new Date().getFullYear() - site.gruendung) / 5) * 5;

const zahlen = [
  { wert: `${jahre}+`, text: ['Jahre', 'Erfahrung'] },
  { wert: String(leistungen.length).padStart(2, '0'), text: ['Leistungsbereiche', 'aus einer Hand'] },
  { wert: '01', text: ['Persönliche', 'Ansprechperson'] },
];
---

<aside class="streifen" aria-label="CleanCare in Zahlen">
  <div class="wrap">
    <ul class="reihe">
      {zahlen.map((z) => (
        <li>
          <span class="punkt" aria-hidden="true"></span>
          <span class="zahl">{z.wert}</span>
          <span class="text">
            {z.text[0]}<br />{z.text[1]}
          </span>
        </li>
      ))}
      <li class="satz">„Wir übernehmen den Rest.“</li>
    </ul>
  </div>
</aside>

<style>
  /* Keine eigene Fläche und kein durchgehender Balken: die Zahlen stehen auf
     demselben Grund und derselben Textachse wie der Rest der Seite. Nur eine
     feine Linie oben trennt sie vom Auftakt. */
  .streifen {
    padding-block: 0;
  }

  .reihe {
    padding-top: clamp(1.5rem, 1.25rem + 1.2vw, 2.25rem);
    border-top: 1px solid var(--linie);
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.3fr);
    align-items: center;
    gap: clamp(1rem, 0.5rem + 1.6vw, 2.25rem);
  }

  /* Trennlinien zwischen den Zellen statt Rahmen um jede Zelle — wie in der
     Referenz. Die erste Zelle bekommt keine, sonst hinge eine Linie am Rand. */
  .reihe li + li {
    border-left: 1px solid var(--linie-2);
    padding-left: clamp(1rem, 0.5rem + 1.6vw, 2.25rem);
  }

  .reihe li {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 0.5rem 0.6875rem;
  }

  .punkt {
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: var(--r-pill);
    background: var(--blau);
    flex: none;
  }

  .zahl {
    font-family: var(--font);
    font-size: clamp(1.5rem, 1.25rem + 1.1vw, 2.125rem);
    font-weight: 620;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .text {
    font-family: var(--font);
    font-size: 0.6875rem;
    font-weight: 560;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.35;
    color: var(--ink-2);
  }

  .satz {
    display: block;
    font-family: var(--font);
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
    font-weight: 500;
    font-style: italic;
    letter-spacing: -0.015em;
    color: var(--blau);
    text-align: right;
    text-wrap: balance;
  }

  /* Zwei Zeilen à zwei Zellen; der Merksatz rückt unter die Zahlen und
     verliert dabei die Trennlinie, die dort nur quer stünde. */
  @media (max-width: 62rem) {
    .reihe { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .reihe li:nth-child(3) { border-left: 0; padding-left: 0; }
    .satz { text-align: left; }
  }

  @media (max-width: 34rem) {
    .reihe { grid-template-columns: 1fr; gap: var(--s-4); }
    .reihe li + li {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--linie-2);
      padding-top: var(--s-4);
    }
  }
</style>
