---
import { site } from '../data/site';

interface Props {
  titel?: string;
  text?: string;
}
const {
  titel = 'Sagen Sie uns, um welches Objekt es geht.',
  text = 'Vier Angaben genügen für den Anfang: Objektart, Ort, Fläche und gewünschter Rhythmus. Alles Weitere klären wir bei der Besichtigung.',
} = Astro.props;
---

<section class="abschnitt-eng">
  <div class="wrap">
    <div class="band">
      <div class="wort">
        <h2>{titel}</h2>
        <p>{text}</p>
      </div>

      <div class="tat">
        <a class="btn hell" href="/anfrage">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3.5" y="5" width="17" height="15.5" rx="2.5" />
            <path d="M8 3v4M16 3v4M3.5 10h17" />
          </svg>
          Angebot anfordern
        </a>
        <div class="direkt">
          <a href={`tel:${site.telefonLink}`} class="mass">{site.telefon}</a>
          <a href={`mailto:${site.email}`} class="mass">{site.email}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    align-items: center;
    padding: var(--einzug);
    background: linear-gradient(135deg, var(--blau-tief), var(--ink) 70%);
    border-radius: var(--r-panel);
    color: oklch(94% 0.015 250);
    box-shadow: var(--schwebe-2);
    margin-inline: calc(var(--einzug) * -1);
  }

  .wort h2 { color: #fff; max-width: 18ch; }
  .wort p { margin-top: var(--s-4); color: oklch(88% 0.02 250); max-width: 48ch; }

  .tat { display: grid; gap: var(--s-4); justify-items: start; }

  .hell { background: #fff; color: var(--ink); box-shadow: none; }
  .hell:hover { background: oklch(96% 0.008 250); }

  .direkt { display: grid; gap: 0.375rem; }
  .direkt a { color: oklch(90% 0.02 250); text-decoration: none; }
  .direkt a:hover { color: #fff; text-decoration: underline; }

  @media (max-width: 52rem) {
    .band { grid-template-columns: 1fr; }
    .tat { justify-items: stretch; }
    .hell { justify-content: center; }
  }
</style>
