---
/**
 * Die Leistungskarte, wie sie auf der Startseite eingeführt wurde. Sie liegt
 * hier zentral, damit Startseite, Leistungsübersicht und die Detailseite
 * dieselbe Karte zeigen — vorher gab es drei Fassungen, die auseinandergelaufen
 * sind (die Übersicht hatte 6px Radius statt --r-karte und gar keine Bilder).
 *
 * Erwartet ein <ul> als Elternteil; das Raster bringt die jeweilige Seite mit.
 */
import { Image } from 'astro:assets';
import type { Leistung } from '../data/leistungen';
import { nutzungen } from '../data/site';

interface Props {
  leistung: Leistung;
  /** Wie breit die Karte im jeweiligen Raster wird — steuert die Bildauswahl. */
  sizes?: string;
  /**
   * Blendet die Flächenart als Farbmarke ein. Auf der Übersicht ersetzt das die
   * frühere Gruppierung: die Sortierung bleibt sichtbar, ohne dass Gruppen mit
   * nur einer Leistung halbe Reihen leer stehen lassen.
   */
  flaeche?: boolean;
  /**
   * `bild` — zweigeteilte Karte mit Foto. Übersicht und Detailseiten.
   * `kompakt` — ohne Foto, mit Symbol und Mehr-Verweis. Startseite, wo sechs
   * Karten nebeneinander stehen und Fotos in dieser Größe nichts mehr zeigen.
   */
  variante?: 'bild' | 'kompakt';
}

const {
  leistung,
  sizes = '(max-width: 40rem) 45vw, 15rem',
  flaeche = false,
  variante = 'bild',
} = Astro.props;
const nutzung = nutzungen.find((n) => n.id === leistung.nutzung);

const bilder = import.meta.glob<{ default: ImageMetadata }>('../assets/img/*.{webp,png,jpg}', {
  eager: true,
});
const bild = leistung.bild ? bilder[`../assets/img/${leistung.bild}`]?.default : undefined;
---

<li>
  <a
    href={`/leistungen/${leistung.slug}`}
    class:list={[`v-${variante}`, flaeche ? `n-${leistung.nutzung}` : undefined]}
  >
    {variante === 'kompakt' ? (
      <>
        <span class="symbol" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
            <path d="m5 12.5 4.5 4.5L19 7.5" />
          </svg>
        </span>
        <h3>{leistung.name}</h3>
        <p>{leistung.kurz}</p>
        {/* Kein <a> im <a>: der Verweis ist eine Schaltfläche fürs Auge, die
            ganze Karte ist der Link. */}
        <span class="mehr">
          Mehr
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h13m-5.5-5.5L18.5 12l-6 5.5" />
          </svg>
        </span>
      </>
    ) : (
      <>
        <div class="karte-wort">
          {flaeche && nutzung && (
            <p class="feld flaeche">
              <span class="marke-farbe" aria-hidden="true"></span>
              {nutzung.kurz}
            </p>
          )}
          <h3>{leistung.name}</h3>
          <p>{leistung.kurz}</p>
        </div>

        <div class="karte-medium">
          {bild ? (
            <Image
              src={bild}
              alt={leistung.bildAlt ?? ''}
              widths={[240, 400, 640]}
              sizes={sizes}
              loading="lazy"
            />
          ) : (
            <span class="ersatz">
              <span class="label">Üblicher Takt</span>
              <span class="takt">{leistung.takt}</span>
            </span>
          )}
        </div>
      </>
    )}
  </a>
</li>

<style>
  /*
    Zweigeteilte Karte: Text links, Bild rechts. Das Bild füllt seine Hälfte
    vollständig aus und läuft bis an die Kartenkante — deshalb trägt die Karte
    selbst keinen Innenabstand mehr, sondern nur noch der Textteil, und
    `overflow: hidden` schneidet das Bild auf den Kartenradius.
  */
  a {
    display: grid;
    height: 100%;
    background: var(--panel-2);
    border: 1px solid var(--linie);
    border-radius: var(--r-karte);
    text-decoration: none;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease), box-shadow 0.25s var(--ease), transform 0.25s var(--ease);
  }
  a:hover {
    background: var(--panel);
    border-color: var(--linie-2);
    box-shadow: var(--schwebe-2);
    transform: translateY(-3px);
  }

  .v-bild {
    grid-template-columns: minmax(0, 1fr) minmax(0, 42%);
    align-items: stretch;
    overflow: hidden;
  }

  /* ---------- Kompakte Fassung: Symbol, Text, Mehr-Verweis ---------- */

  /* Vier feste Reihen: Symbol, Überschrift, Text, Verweis. Die Textreihe ist
     die dehnbare — dadurch steht „Mehr" in allen Karten einer Zeile auf
     derselben Höhe, auch wenn die Texte unterschiedlich lang sind. */
  /*
    Umgekehrte Flächenlogik als bei der Bildvariante, und zwar mit Absicht:
    Die Bildkarte liegt auf der Übersicht in einem weißen Panel und braucht
    deshalb den leicht abgetönten Grund, um sich davon abzuheben. Die kompakte
    Karte steht auf der Startseite direkt auf `--grund` — dort ist Weiß die
    hellere, klarer abgesetzte Fläche, wie bei den Standortkarten daneben.
    Der Hover geht entsprechend nach unten statt nach oben.
  */
  .v-kompakt {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto 1fr auto;
    justify-items: start;
    gap: var(--s-3);
    padding: var(--s-5);
    background: var(--panel);
  }
  .v-kompakt:hover { background: var(--panel-2); }

  /* Kleiner als die übliche h3. Grund sind die Komposita: „Solaranlagen-
     reinigung" ist ein einziges Wort ohne Umbruchstelle und braucht bei 24px
     rund 255px — im Kasten stehen bei vier Spalten aber nur 211px zur
     Verfügung, das Wort lief also über den Rand hinaus. Bei 18px passt das
     längste Wort mit Abstand zum Rand. */
  .v-kompakt h3 {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.25;
    /* Fünf Karten nebeneinander lassen je Karte nur rund 180px Textbreite.
       „Treppenhausreinigung" braucht ungetrennt 197px und hat als Kompositum
       keine Umbruchstelle. Die Silbentrennung greift hier statt der bisherigen
       Vergrößerung der Karte; die Seite ist auf de-DE gestellt, der Browser
       trennt also nach deutschen Regeln. */
    hyphens: auto;
  }

  .symbol {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-pill);
    background: var(--blau-sanft);
    color: var(--blau);
    transition: background 0.25s var(--ease), color 0.25s var(--ease);
  }
  .v-kompakt:hover .symbol {
    background: var(--blau);
    color: var(--panel);
  }

  .mehr {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    /* Eine volle leere Textzeile über dem Verweis, zusätzlich zum Rasterabstand
       von 12px. Der Wert ist die Zeilenhöhe des Kartentextes (15px × 1.55),
       damit der Abstand mitwächst, wenn die Textgröße einmal geändert wird. */
    margin-top: calc(0.9375rem * 1.55);
    font-family: var(--font);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--blau);
  }
  .mehr svg { transition: transform 0.25s var(--ease); }
  .v-kompakt:hover .mehr svg { transform: translateX(3px); }

  @media (prefers-reduced-motion: reduce) {
    a:hover { transform: none; }
    .v-kompakt:hover .mehr svg { transform: none; }
  }

  .flaeche {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }
  .marke-farbe {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 2px;
    background: var(--linie-2);
    flex: none;
  }
  .n-buero .marke-farbe { background: var(--nutz-buero); }
  .n-verkehr .marke-farbe { background: var(--nutz-verkehr); }
  .n-sanitaer .marke-farbe { background: var(--nutz-sanitaer); }
  .n-glas .marke-farbe { background: var(--nutz-glas); }
  .n-technik .marke-farbe { background: var(--nutz-technik); }

  .karte-wort {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding: var(--s-5);
  }
  .karte-wort h3 { margin: 0; }

  p { margin: 0; font-size: 0.9375rem; color: var(--ink-2); }

  /* Randbündig: das Bild liegt absolut in seiner Hälfte und füllt sie ganz aus.
     Die Mindesthöhe trägt die Fläche, nicht das Bild — sonst fällt es in einer
     Rasterzeile ohne feste Höhe auf null zusammen. */
  .karte-medium {
    position: relative;
    min-height: 11.5rem;
    background: var(--blau-nebel);
  }
  .karte-medium :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Zwei der acht Leistungen haben kein Foto — dort steht der übliche Takt. */
  .ersatz {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    gap: 0.375rem;
    padding: var(--s-4);
  }
  .ersatz .takt {
    font-family: var(--font);
    font-size: 1.0625rem;
    font-weight: 560;
    color: var(--blau);
  }

  /* Auf schmalen Geräten steht das Bild wieder unter dem Text — nebeneinander
     bliebe für beides zu wenig Breite. */
  @media (max-width: 34rem) {
    .v-bild { grid-template-columns: 1fr; }
    .karte-medium { min-height: 9rem; }
  }
</style>
