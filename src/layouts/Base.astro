---
import '@fontsource-variable/rubik';
import '../styles/base.css';
import '../styles/einblenden.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Ohne Suffix, wenn der Titel schon vollständig ist */
  bare?: boolean;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, bare = false, ogImage = '/og.png', noindex = false } = Astro.props;
/*
  Kurzer Marken-Zusatz statt der vollen Firmierung. Google zeigt rund 60 Zeichen;
  „— CleanCare Gebäudeservice GmbH" verbrauchte davon allein 31 und schnitt
  mehrere Seitentitel ab (Landkreis Harburg lag bei 69 Zeichen). Das Stichwort
  gehört nach vorn, der Name ans Ende.
*/
const seiteTitel = bare ? title : `${title} — CleanCare`;

/*
  Sicherheitsnetz für die Meta-Beschreibung: Google schneidet bei rund 160
  Zeichen ab, und mitten im Wort abgeschnittene Texte sehen im Suchergebnis
  nachlässig aus. Gekürzt wird an der letzten Wortgrenze. Die Texte auf den
  Seiten sind so geschrieben, dass sie ohnehin darunter liegen — das hier greift
  nur, wenn später ein längerer Ort- oder Leistungsname dazukommt.
*/
function kuerzen(text: string, grenze = 158) {
  if (text.length <= grenze) return text;
  const schnitt = text.slice(0, grenze);
  return schnitt.slice(0, schnitt.lastIndexOf(' ')).replace(/[,;:—-]$/, '') + '…';
}
const beschreibungKurz = kuerzen(description);
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/(.+)\/$/, '$1');

/*
  Beim Vorschau-Build auf GitHub Pages liegt die Seite in einem Unterordner.
  Absolute Pfade wie `/favicon.svg` zeigen dort an der Seite vorbei — deshalb
  laufen alle eigenen Dateien über `basis`. Genau daran hing das fehlende Logo
  in der Kopfleiste: zwei kaputte Bilder statt der Marke.
*/
/*
  BASE_URL liefert je nach Konfiguration `/name` oder `/name/`. Ohne diese
  Normalisierung entstand daraus `/cleancare-rundcc-logo-neu.png` — genau der
  fehlende Schrägstrich, an dem die Marke im Vorschau-Build erneut hing.
*/
const basis = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const ogUrl = new URL(basis + ogImage.replace(/^\//, ''), Astro.site).href;
---

<!doctype html>
<html lang="de-DE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seiteTitel}</title>
    <meta name="description" content={beschreibungKurz} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={seiteTitel} />
    <meta property="og:description" content={beschreibungKurz} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — Gebäudereinigung in ${site.ort} und Hamburg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seiteTitel} />
    <meta name="twitter:description" content={beschreibungKurz} />
    <meta name="twitter:image" content={ogUrl} />

    <!-- Logo-Navy. Stand vorher auf #101c5e — ein Rest aus einer früheren Farbwelt. -->
    <meta name="theme-color" content="#16283f" />
    {/* Browser-Miniatur: die neue Bildmarke. Zwei Groessen, damit der Browser
        die passende nimmt und nicht eine grosse herunterrechnet. */}
    <link rel="icon" href={`${basis}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="icon" href={`${basis}icon-192.png`} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={`${basis}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${basis}sitemap-index.xml`} />
    <slot name="head" />
  </head>
  <body>
    <script is:inline>
      /* Muss vor dem ersten Zeichnen laufen: erst dieses Kennzeichen schaltet
         den verborgenen Ausgangszustand des Einblendens ueberhaupt ein. */
      document.documentElement.dataset.js = 'an';
    </script>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <SiteHeader />
    <main id="inhalt">
      <slot />
    </main>
    <SiteFooter />
    <script>
      /*
        Blendet Elemente mit `data-einblenden` ein, sobald sie ins Bild kommen.
        Ein Beobachter fuer die ganze Seite statt einer je Baustein.

        `data-einblenden-gruppe` am Elternteil staffelt dessen Kinder: Jedes
        bekommt 90ms mehr Verzoegerung als das vorige, damit sie nacheinander
        hereinkommen statt gleichzeitig.
      */
      for (const gruppe of document.querySelectorAll('[data-einblenden-gruppe]')) {
        /* Schrittweite je Gruppe: viele kleine Karten vertragen weniger als
           drei grosse Schritte, sonst wartet man auf die letzte. */
        const schritt = Number(gruppe.dataset.einblendenGruppe) || 90;
        [...gruppe.children].forEach((kind, i) => {
          kind.setAttribute('data-einblenden', '');
          /* Zwei Staffelungen fuer zwei Verfahren: Millisekunden fuer die
             Fassung mit Ausloeser, Wegversatz fuer die scrollgebundene. Welche
             greift, entscheidet der Browser ueber @supports. */
          kind.style.setProperty('--verzug', `${i * schritt}ms`);
          kind.style.setProperty('--versatz', `${i * (schritt / 12)}%`);
        });
      }

      const beobachter = new IntersectionObserver(
        (eintraege) => {
          for (const e of eintraege) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('ist-da');
            beobachter.unobserve(e.target);
          }
        },
        /* Erst ausloesen, wenn das Element ein Stueck weit im Bild steht —
           sonst ist die Bewegung vorbei, bevor man sie sehen kann. */
        { rootMargin: '0px 0px -12% 0px', threshold: 0.1 },
      );

      for (const el of document.querySelectorAll('[data-einblenden]')) {
        beobachter.observe(el);
      }
    </script>
  </body>
</html>
