---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Ablauf from '../components/Ablauf.astro';
import Stimmen from '../components/Stimmen.astro';
import ContactBand from '../components/ContactBand.astro';
import LeistungKarte from '../components/LeistungKarte.astro';
import SonderKarte from '../components/SonderKarte.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../data/site';
import { leistungen, hauptleistungen } from '../data/leistungen';
import { standorte } from '../data/standorte';
import held from '../assets/img/cleancare-header-glass.webp';
import haus from '../assets/img/redd-f-ptrzqc_h1r4-unsplash.webp';

const beschreibung =
  'Unterhaltsreinigung für Büros, Praxen und Gewerbeobjekte in Seevetal, Landkreis Harburg und Hamburg. Familienbetrieb seit 2009, Angebot nach Besichtigung.';

/* Die fünf Hauptleistungen einzeln; Fassade, Dach und Solar stehen gesammelt
   im sechsten Feld, so wie der bestehende Auftritt sie führt. */
const gezeigt = hauptleistungen;

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${site.url}/#unternehmen`,
    name: site.name,
    description: beschreibung,
    url: site.url,
    telephone: site.telefon,
    email: site.email,
    foundingDate: String(site.gruendung),
    founder: { '@type': 'Person', name: site.geschaeftsfuehrung },
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.strasse,
      postalCode: site.plz,
      addressLocality: site.ort,
      addressCountry: site.land,
    },
    areaServed: site.gebiet.map((g) => ({ '@type': 'Place', name: g })),
    sameAs: [site.linkedin, site.provenexpert],
    knowsLanguage: 'de-DE',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Leistungen',
      itemListElement: leistungen.map((l) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: l.name, url: `${site.url}/leistungen/${l.slug}` },
      })),
    },
    // Kein review-Block: Selbst eingebundene Bewertungen über das eigene
    // Unternehmen verstoßen gegen Googles Richtlinien und können eine manuelle
    // Maßnahme auslösen. Die echten Bewertungen liegen bei ProvenExpert, das
    // Profil ist oben unter sameAs verknüpft. Sichtbar bleiben die Stimmen
    // weiterhin über die Stimmen-Komponente.
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    url: site.url,
    name: site.name,
    inLanguage: 'de-DE',
    publisher: { '@id': `${site.url}/#unternehmen` },
  },
];
---

<Base
  title="Gebäudereinigung Seevetal & Hamburg | CleanCare"
  description={beschreibung}
  bare={true}
>
  <JsonLd slot="head" daten={ld} />

  <section class="auftakt">
    <div class="auftakt-bild">
      <Image
        src={held}
        alt="Mitarbeiterin reinigt mit einem Abzieher die raumhohe Glasfront einer hellen Bürolobby"
        widths={[900, 1400, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="wrap auftakt-inhalt">
      <div class="wort">
          <p class="label auftakt-marke">Gebäudeservice aus Seevetal</p>
          <h1>Der letzte Reinigungs&shy;wechsel, den Sie machen.</h1>
          <p class="lead">
            Feste Teams, die Ihr Objekt kennen. Eine Ansprechperson, die rangeht. Und eine
            Qualität, die auch im dritten Jahr noch stimmt.
          </p>

          <div class="aktionen">
            <a class="btn" href="/anfrage">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3.5" y="5" width="17" height="15.5" rx="2.5" />
                <path d="M8 3v4M16 3v4M3.5 10h17" />
              </svg>
              Angebot anfordern
            </a>
            <a class="btn btn-2" href={`tel:${site.telefonLink}`}>
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7 2 2 0 0 1 6.5 3.5Z" />
              </svg>
              {site.telefon}
            </a>
          </div>
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      {/* Die Überschrift steht frei über den Karten, nicht mit ihnen in einem
          gemeinsamen Panel: die Karten sind hier selbst die Kästen. */}
      <div class="leistungs-kopf">
        <p class="label">Leistungen</p>
        <h2>Was wir übernehmen</h2>
        <p class="lead">
          Von der täglichen Unterhaltsreinigung bis zur Fassade. Alles aus einer Hand, mit
          festen Teams und einem Rhythmus, der zu Ihrem Betrieb passt.
        </p>
      </div>

      <ul class="leistungsraster">
        {gezeigt.map((l) => (
          <LeistungKarte leistung={l} variante="kompakt" />
        ))}
        <SonderKarte variante="kompakt" />
      </ul>
    </div>
  </section>

  <Ablauf />

  <section class="abschnitt">
    <div class="wrap">
      <div class="panel haus-panel">
        <figure class="haus-bild">
          <Image
            src={haus}
            alt="Arbeitsplatz in einem hellen Büro mit Schreibtisch und Fenster"
            widths={[480, 800, 1100]}
            sizes="(max-width: 60rem) 100vw, 32rem"
            loading="lazy"
          />
        </figure>
        <div class="haus-wort">
          <p class="label">Über CleanCare</p>
          <h2>Ein Familienbetrieb, der seine Objekte kennt</h2>
          <p>
            Wir sind ein seit {site.gruendung} tätiges Familienunternehmen in zweiter Generation,
            spezialisiert auf die ganzheitliche Unterhaltsreinigung gewerblich genutzter
            Immobilien.
          </p>
          <p>
            Traditionelle Werte, verbunden mit modernem Innovationsgeist: Wir verknüpfen die
            Erfahrung aus über 15 Jahren mit Digitalisierung und Nachhaltigkeit — damit Sie sich
            ganz auf Ihr Kerngeschäft konzentrieren können.
          </p>
          <p class="signatur">{site.geschaeftsfuehrung}, Geschäftsführerin</p>
          <a class="btn btn-3" href="/ueber-uns">Mehr über uns</a>
        </div>
      </div>
    </div>
  </section>

  <Stimmen />

  <section class="abschnitt">
    <div class="wrap">
      <div class="kopf">
        <p class="label">Einsatzgebiet</p>
        <h2>Wo wir unterwegs sind</h2>
        <p class="lead">
          Der Sitz ist Seevetal. Von dort betreuen wir Objekte im Landkreis Harburg und in Hamburg,
          darüber hinaus in Niedersachsen und Schleswig-Holstein.
        </p>
      </div>
      <ul class="orte">
        {standorte.map((s) => (
          <li>
            <a href={`/einsatzgebiet/${s.slug}`}>
              <h3>{s.ort}</h3>
              <p>{s.intro}</p>
              <span class="weiter">
                Ansehen
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h13M13 6l6 6-6 6" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ContactBand />
</Base>

<style>
  /* ---------- Auftakt ---------- */
  /* Der Auftakt füllt die erste Bildschirmseite: ein randloses Objektfoto, der
     Text schwebt darüber. Die Kopfleiste steht im Fluss darüber, ihre Höhe wird
     deshalb abgezogen — sonst reicht der Auftakt über die Bildschirmkante und
     die Seite scrollt schon beim Öffnen. */
  .auftakt {
    position: relative;
    padding-top: 0;
    padding-bottom: 0;
    /* `main` hält oben --reihe-oben Abstand für alle Seiten. Der Auftakt ist
       randlos und holt ihn zurück, damit das Foto direkt unter der Kopfleiste
       ansetzt und darüber kein heller Streifen stehen bleibt. */
    margin-top: calc(var(--reihe-oben) * -1);
    min-height: calc(100svh - var(--kopf-h));
    display: grid;
    align-items: center;
    overflow: hidden;
  }

  .auftakt-bild {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .auftakt-bild :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Das Foto ist mit 1920×823 sehr breit. Bei hohen Fenstern beschneidet
       `cover` seitlich stark — der Bildausschnitt wird deshalb nach rechts
       gezogen, damit die Person an der Glasfront im Bild bleibt. */
    object-position: 70% center;
  }

  /* Der Verlauf von links: er trägt den Text. Ohne ihn steht dunkle Schrift auf
     einem Foto, dessen Helligkeit je nach Ausschnitt wechselt. Der Verlauf
     endet vor der Bildmitte, damit die Glasfront rechts frei bleibt. */
  .auftakt-bild::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      var(--grund) 0%,
      var(--grund) 24%,
      color-mix(in oklab, var(--grund) 72%, transparent) 44%,
      color-mix(in oklab, var(--grund) 24%, transparent) 62%,
      transparent 78%
    );
  }

  .auftakt-inhalt {
    position: relative;
    z-index: 1;
    padding-block: var(--reihe-oben);
  }

  .auftakt-marke { display: block; margin-bottom: var(--s-4); max-width: none; }

  .wort h1 {
    margin-bottom: var(--s-5);
    /* Keine automatische Silbentrennung: „Objek-te" im Titel liest sich wie ein
       Fehler. `manual` lässt aber die im Text gesetzten &shy; zu — nötig für
       lange Komposita wie „Reinigungs­wechsel", die sonst breiter werden als die
       Rasterspalte und über das Bild laufen. Getrennt wird nur an der Fuge. */
    hyphens: manual;
    max-width: 15ch;
  }
  /* Der Vorspann bleibt in der gedeckten Zone des Verlaufs. Ohne Begrenzung
     reicht er auf mittleren Breiten bis in die Glasfront hinein und verliert
     dort den Kontrast. */
  .wort .lead { margin-bottom: var(--s-6); max-width: 32ch; }

  .aktionen { display: flex; flex-wrap: wrap; gap: var(--s-3); }

  /* ---------- Leistungen ---------- */
  /* Überschrift, Vorspann und Aktion stehen mittig über dem Raster — so hält es
     die Referenz. */
  .panel-kopf {
    display: grid;
    justify-items: center;
    text-align: center;
    margin-bottom: clamp(2.25rem, 1.75rem + 2vw, 3.5rem);
  }
  .panel-kopf h2 { margin-bottom: var(--s-5); max-width: 20ch; }
  .panel-kopf .lead { max-width: var(--mass-mitte); }
  .panel-kopf .btn { flex: none; }

  /* Zwei Spalten: die Karten sind jetzt zweigeteilt (Text links, Bild rechts)
     und brauchen dafür Breite. Sechs Karten ergeben drei volle Reihen. */
  .leistungs-kopf {
    text-align: center;
    margin-bottom: clamp(2.25rem, 1.75rem + 2vw, 3.5rem);
  }
  /* `p` bringt aus base.css eine Höchstbreite mit; ohne `margin-inline: auto`
     steht die Box links und nur ihr Text ist darin zentriert. */
  .leistungs-kopf .label { display: block; margin: 0 auto var(--s-3); max-width: none; }
  .leistungs-kopf h2 { margin-bottom: var(--s-5); max-width: 20ch; margin-inline: auto; }
  .leistungs-kopf .lead { max-width: var(--mass-mitte); margin-inline: auto; }

  /*
    Selbstregelnd statt fester Spaltenzahl. Feste Stufen waren hier falsch: Bei
    vier Spalten und 1190px Fensterbreite blieben je Karte nur 214px, und
    „Solaranlagenreinigung" stand über den Rand hinaus — ein Kompositum hat
    keine Umbruchstelle.

    15.5rem ist die Breite, ab der das längste Wort mit Abstand zum Rand passt.
    Damit kann kein Fenstermaß mehr eine zu schmale Spalte erzeugen: Es entstehen
    von selbst vier, drei, zwei oder eine Spalte. `min(…, 100%)` fängt Geräte ab,
    die schmaler als eine Mindestspalte sind.
  */
  .leistungsraster {
    list-style: none;
    display: grid;
    /* 17rem statt 15.5rem: Bei sechs Feldern gehen drei Spalten in zwei volle
       Reihen auf, vier Spalten ließen die zweite Reihe halb leer. */
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    /* Karten sind innerhalb einer Reihe von Haus aus gleich hoch, zwischen den
       Reihen aber nicht: Die erste Reihe stand auf 290px, die zweite auf 267px,
       weil „Glas- und Fensterreinigung" als einzige Überschrift zweizeilig ist.
       `1fr` gibt allen Reihen dieselbe Höhe. */
    grid-auto-rows: 1fr;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
  }

  /* ---------- Haus ---------- */
  .haus-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    align-items: center;
  }
  .haus-bild { margin: 0; }
  .haus-bild :global(img) {
    width: 100%;
    height: clamp(16rem, 12rem + 16vw, 24rem);
    object-fit: cover;
    border-radius: var(--r-karte);
  }
  .haus-wort .label { display: block; margin-bottom: var(--s-3); }
  .haus-wort h2 { margin-bottom: var(--s-4); }
  /* Nicht die Abschnittsmarke: die ist ebenfalls ein <p> und trägt ihr
     eigenes Dunkelblau aus base.css. */
  .haus-wort p:not(.label) { color: var(--ink-2); }
  .signatur {
    font-family: var(--font);
    font-weight: 540;
    color: var(--ink);
    margin-top: var(--s-5);
  }
  .haus-wort .btn { margin-top: var(--s-5); }

  /* ---------- Orte ---------- */
  .kopf .label { display: block; margin-bottom: var(--s-3); }

  .orte {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--s-4);
  }
  .orte a {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    height: 100%;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    background: var(--panel);
    border-radius: var(--r-karte);
    text-decoration: none;
    box-shadow: var(--schwebe-1);
    transition: box-shadow 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .orte a:hover { box-shadow: var(--schwebe-2); transform: translateY(-3px); }
  .orte h3 { margin: 0; }
  .orte p { margin: 0; font-size: 0.9375rem; color: var(--ink-2); }
  .weiter {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--blau);
    font-family: var(--font);
    font-size: 0.9375rem;
    font-weight: 540;
  }

  @media (max-width: 64rem) {
    .haus-panel { grid-template-columns: 1fr; }
  }

  /* Auf schmalen Fenstern gibt es keine freie Fläche mehr neben dem Motiv: der
     Verlauf läuft dort von unten nach oben, der Text sitzt in der unteren
     Hälfte. Ein Verlauf von links würde das Bild nur zudecken. */
  @media (max-width: 52rem) {
    .auftakt { align-items: end; }
    /* Die Rufleiste liegt fest am unteren Rand. Ohne diesen Abstand verschwindet
       der letzte Knopf des Auftakts dahinter. */
    .auftakt-inhalt { padding-bottom: calc(var(--rufleiste-h, 4.125rem) + var(--s-5)); }
    .auftakt-bild :global(img) { object-position: 74% center; }
    /* Hochkant bleibt vom 1920×823-Bild nur ein schmaler Ausschnitt übrig; das
       Motiv steht dann zwangsläufig hinter dem Text. Statt den Ausschnitt zu
       verschieben — dabei landet immer irgendein Detail hinter der Schrift —
       liegt das Foto hier als ruhiger Schleier hinter der Seite und wird nach
       oben hin frei. Lesbarkeit geht vor Motiv. */
    .auftakt-bild::after {
      background: linear-gradient(
        to top,
        var(--grund) 0%,
        color-mix(in oklab, var(--grund) 92%, transparent) 46%,
        color-mix(in oklab, var(--grund) 78%, transparent) 68%,
        color-mix(in oklab, var(--grund) 55%, transparent) 88%,
        color-mix(in oklab, var(--grund) 40%, transparent) 100%
      );
    }
  }
  @media (max-width: 48rem) {
    .panel-kopf { flex-direction: column; align-items: start; }
  }
</style>
