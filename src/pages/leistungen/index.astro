---
import Base from '../../layouts/Base.astro';
import ContactBand from '../../components/ContactBand.astro';
import LeistungKarte from '../../components/LeistungKarte.astro';
import SonderKarte from '../../components/SonderKarte.astro';
import JsonLd from '../../components/JsonLd.astro';
import { site, nutzungen } from '../../data/site';
import { leistungen, hauptleistungen } from '../../data/leistungen';

const beschreibung =
  'Unterhaltsreinigung, Treppenhaus, Glas, Grundreinigung und Hygieneartikelservice für Gewerbeobjekte in Seevetal und Hamburg — dazu Sonderreinigungen.';

/* Nach Flächenart sortiert, aber in einem durchgehenden Raster. Eigene Gruppen
   je Nutzungsart ließen vier von fünf Reihen halb leer stehen — drei Gruppen
   haben nur eine einzige Leistung. Die Zuordnung trägt jetzt die Karte selbst. */
const sortiert = nutzungen.flatMap((n) => hauptleistungen.filter((l) => l.nutzung === n.id));

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Leistungen', item: `${site.url}/leistungen` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Leistungen der CleanCare Gebäudeservice GmbH',
    itemListElement: leistungen.map((l, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: l.name,
      url: `${site.url}/leistungen/${l.slug}`,
    })),
  },
];
---

<Base title="Leistungen der Gebäudereinigung" description={beschreibung}>
  <JsonLd slot="head" daten={ld} />

  <section class="kopfteil">
    <div class="wrap mitte">
      <p class="label">Leistungen</p>
      <h1>Fünf Leistungen, ein Konzept</h1>
      <p class="lead">
        Sortiert nach der Fläche, auf der sie stattfinden. Denn die Nutzungsart entscheidet über
        Verfahren, Mittel und Takt — nicht der Name der Leistung.
      </p>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="panel">
        <ul class="karten">
          {sortiert.map((l) => (
            <LeistungKarte
              leistung={l}
              sizes="(max-width: 34rem) 90vw, (max-width: 52rem) 40vw, 15rem"
            />
          ))}
          <SonderKarte variante="bild" sizes="(max-width: 34rem) 90vw, (max-width: 52rem) 40vw, 15rem" />
        </ul>

        <!-- Kein eigener Kasten: der Sonderwunsch gehört zur Liste darüber und
             steht deshalb im selben Panel, abgesetzt durch eine feine Linie. -->
        <div class="nachfrage">
          <div>
            <p class="label">Sonderwunsch</p>
            <h2>Leistung nicht dabei?</h2>
            <p class="lead">
              Kommen Sie gerne auf uns zu, sollte eine von Ihnen gewünschte Leistung nicht
              aufgeführt sein. Gerne bieten wir Ihnen individuelle Leistungen auf Wunsch an.
            </p>
          </div>
          <a class="btn" href="/anfrage">Anfrage stellen <span class="pfeil" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <ContactBand />
</Base>

<style>
  /* Abschnittsmarke über der Überschrift. `.mitte` zentriert seine Kinder
     bereits; die Höchstbreite aus `p` wird hier aufgehoben, damit die Box die
     volle Breite hat und ihr Text wirklich in der Mitte steht. */
  .mitte > .label { display: block; margin-bottom: var(--s-3); max-width: none; }

  .kopfteil {
    padding-block: 0;
  }
  .kopfteil h1 { margin-bottom: var(--s-4); max-width: 14ch; }

  /* Dasselbe Raster wie auf der Startseite: zwei Spalten, weil die Karte
     zweigeteilt ist (Text links, Bild rechts) und dafür Breite braucht.
     Acht Leistungen ergeben damit vier volle Reihen. */
  .karten {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* Auch zwischen den Reihen gleich hoch, nicht nur innerhalb einer Reihe. */
    grid-auto-rows: 1fr;
    gap: var(--s-4);
  }
  @media (max-width: 52rem) {
    .karten { grid-template-columns: 1fr; }
  }

  .nachfrage {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    border-top: 1px solid var(--linie);
  }
  .nachfrage .label { display: block; margin-bottom: var(--s-3); }
  .nachfrage h2 { margin-bottom: var(--s-4); }
  .nachfrage .btn { flex: none; }

  @media (max-width: 48rem) {
    .nachfrage { flex-direction: column; align-items: start; }
  }
</style>
