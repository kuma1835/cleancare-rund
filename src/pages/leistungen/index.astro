---
import Base from '../../layouts/Base.astro';
import ContactBand from '../../components/ContactBand.astro';
import LeistungKarte from '../../components/LeistungKarte.astro';
import JsonLd from '../../components/JsonLd.astro';
import { site, nutzungen } from '../../data/site';
import { leistungen } from '../../data/leistungen';

const beschreibung =
  'Unterhaltsreinigung, Treppenhaus, Glas und Fenster, Grundreinigung, Hygieneartikel, Fassade, Dach und Solar — acht Leistungen für gewerbliche Objekte in Seevetal, Hamburg und Norddeutschland.';

/* Nach Flächenart sortiert, aber in einem durchgehenden Raster. Eigene Gruppen
   je Nutzungsart ließen vier von fünf Reihen halb leer stehen — drei Gruppen
   haben nur eine einzige Leistung. Die Zuordnung trägt jetzt die Karte selbst. */
const sortiert = nutzungen.flatMap((n) => leistungen.filter((l) => l.nutzung === n.id));

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Leistungen', item: `${site.url}/leistungen` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Leistungen der CleanCare Gebäudeservice GmbH',
    itemListElement: leistungen.map((l, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: l.name,
      url: `${site.url}/leistungen/${l.slug}`,
    })),
  },
];
---

<Base title="Leistungen" description={beschreibung}>
  <JsonLd slot="head" daten={ld} />

  <section class="kopfteil">
    <div class="wrap">
      <h1>Acht Leistungen, ein Konzept</h1>
      <p class="lead">
        Sortiert nach der Fläche, auf der sie stattfinden. Denn die Nutzungsart entscheidet über
        Verfahren, Mittel und Takt — nicht der Name der Leistung.
      </p>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="panel">
        <div class="panel-kopf">
          <h2>Alle acht im Überblick</h2>
          <ul class="legende">
            {nutzungen.map((n) => (
              <li class={`n-${n.id}`}>
                <span class="marke-farbe" aria-hidden="true"></span>
                {n.kurz}
              </li>
            ))}
          </ul>
        </div>

        <ul class="karten">
          {sortiert.map((l) => (
            <LeistungKarte
              leistung={l}
              flaeche={true}
              sizes="(max-width: 40rem) 100vw, (max-width: 68rem) 50vw, 22rem"
            />
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="panel nachfrage">
        <div>
          <p class="label">Sonderwunsch</p>
          <h2>Leistung nicht dabei?</h2>
          <p class="lead">
            Kommen Sie gerne auf uns zu, sollte eine von Ihnen gewünschte Leistung nicht aufgeführt
            sein. Gerne bieten wir Ihnen individuelle Leistungen auf Wunsch an.
          </p>
        </div>
        <a class="btn" href="/anfrage">Anfrage stellen <span class="pfeil" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <ContactBand />
</Base>

<style>
  .kopfteil {
    padding-block: 0;
  }
  .kopfteil h1 { margin-bottom: var(--s-4); max-width: 14ch; }

  .panel-kopf {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--s-5);
    margin-bottom: clamp(1.75rem, 1.25rem + 2vw, 2.75rem);
  }
  .panel-kopf h2 { margin: 0; }

  /* Die Farbmarken erklären sich einmal oben, statt fünfmal als Gruppentitel. */
  .legende {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    font-family: var(--font);
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .legende li { display: inline-flex; align-items: center; gap: 0.4375rem; }
  .marke-farbe {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 2px;
    background: var(--linie-2);
    flex: none;
  }
  .n-buero .marke-farbe { background: var(--nutz-buero); }
  .n-verkehr .marke-farbe { background: var(--nutz-verkehr); }
  .n-sanitaer .marke-farbe { background: var(--nutz-sanitaer); }
  .n-glas .marke-farbe { background: var(--nutz-glas); }
  .n-technik .marke-farbe { background: var(--nutz-technik); }

  /* Dasselbe Raster wie die Leistungen auf der Startseite: drei Spalten, damit
     die Karten gleich breit stehen. Die Karte selbst liegt in LeistungKarte. */
  .karten {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
  }
  @media (max-width: 68rem) {
    .karten { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 40rem) {
    .karten { grid-template-columns: 1fr; }
  }

  .nachfrage {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
  }
  .nachfrage .label { display: block; margin-bottom: var(--s-3); }
  .nachfrage h2 { margin-bottom: var(--s-4); }
  .nachfrage .btn { flex: none; }

  @media (max-width: 48rem) {
    .panel-kopf { flex-direction: column; align-items: start; }
    .nachfrage { flex-direction: column; align-items: start; }
  }
</style>
