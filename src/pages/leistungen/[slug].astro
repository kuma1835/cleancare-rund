---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ContactBand from '../../components/ContactBand.astro';
import Stimmen from '../../components/Stimmen.astro';
import LeistungKarte from '../../components/LeistungKarte.astro';
import JsonLd from '../../components/JsonLd.astro';
import { site, nutzungen } from '../../data/site';
import { leistungen } from '../../data/leistungen';

export function getStaticPaths() {
  return leistungen.map((l) => ({ params: { slug: l.slug }, props: { leistung: l } }));
}

const { leistung } = Astro.props;
const bilder = import.meta.glob<{ default: ImageMetadata }>('../../assets/img/*.{webp,png,jpg}', {
  eager: true,
});
const bild = leistung.bild ? bilder[`../../assets/img/${leistung.bild}`]?.default : undefined;
const nutzung = nutzungen.find((n) => n.id === leistung.nutzung)!;
const andere = leistungen.filter((l) => l.slug !== leistung.slug).slice(0, 3);

const beschreibung = `${leistung.name} für gewerbliche Objekte in Seevetal, im Landkreis Harburg und in Hamburg. ${leistung.kurz} Angebot nach Besichtigung.`;

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: leistung.name,
    description: leistung.text,
    serviceType: leistung.name,
    provider: { '@id': `${site.url}/#unternehmen` },
    areaServed: site.gebiet.map((g) => ({ '@type': 'Place', name: g })),
    url: `${site.url}/leistungen/${leistung.slug}`,
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      priceSpecification: {
        '@type': 'PriceSpecification',
        description: 'Individuelles Angebot nach Besichtigung des Objekts',
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Leistungen', item: `${site.url}/leistungen` },
      {
        '@type': 'ListItem',
        position: 3,
        name: leistung.name,
        item: `${site.url}/leistungen/${leistung.slug}`,
      },
    ],
  },
];
---

<Base title={leistung.name} description={beschreibung}>
  <JsonLd slot="head" daten={ld} />

  <section class={`kopfteil n-${leistung.nutzung}`}>
    <div class="wrap">
      <p class="feld flaechenart">
        <span class="marke-farbe" aria-hidden="true"></span>
        {nutzung.name}
      </p>
      <h1>{leistung.name}</h1>
      <p class="lead">{leistung.kurz}</p>
      <div class="aktionen">
        <a class="btn" href="/anfrage">Anfrage stellen <span class="pfeil" aria-hidden="true">→</span></a>
        <a class="btn btn-2" href={`tel:${site.telefonLink}`}>{site.telefon}</a>
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="panel umfang-panel">
        <div class="fliesstext">
          <p class="einstieg">{leistung.text}</p>

          <h2>Was dazugehört</h2>
          <ul class="umfang">
            {leistung.umfang.map((u) => <li>{u}</li>)}
          </ul>
        </div>

        <div class="beiwerk">
          {bild && (
            <figure class="bildblock">
              <Image
                src={bild}
                alt={`Objektsituation, wie sie bei der ${leistung.name} vorkommt`}
                widths={[400, 700, 1000]}
                sizes="(max-width: 56rem) 100vw, 24rem"
                loading="lazy"
              />
            </figure>
          )}
          <dl class="eckdaten">
            <div>
              <dt class="feld">Üblicher Takt</dt>
              <dd class="mass">{leistung.takt}</dd>
            </div>
            <div>
              <dt class="feld">Flächenart</dt>
              <dd class="mass">{nutzung.kurz}</dd>
            </div>
            <div>
              <dt class="feld">Gebiet</dt>
              <dd class="mass">Seevetal · Harburg · Hamburg</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="panel doppel-panel">
        <div>
          <h2>Für welche Objekte</h2>
          <ul class="fuer">
            {leistung.fuer.map((f) => <li class="mass">{f}</li>)}
          </ul>
        </div>
        <div>
          <h2>Wie der Preis entsteht</h2>
          <p>
            Aus der Fläche, ihrer Nutzung und dem Takt — und aus dem, was die Besichtigung zeigt.
            Bodenbeläge, Zugänge und Verkehrsaufkommen verändern den Aufwand deutlich, deshalb gibt
            es bei uns keinen Quadratmeterpreis von der Stange.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="panel weitere">
        <div class="panel-kopf">
          <div>
            <p class="label">Weitere Leistungen</p>
            <h2>Was wir sonst noch übernehmen</h2>
          </div>
          <a class="btn btn-3" href="/leistungen">Alle Leistungen</a>
        </div>
        <ul class="leistungsraster">
          {andere.map((l) => (
            <LeistungKarte leistung={l} sizes="(max-width: 40rem) 100vw, (max-width: 68rem) 50vw, 22rem" />
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Stimmen />
  <ContactBand />
</Base>

<style>
  /* Kopf steht frei auf dem Seitengrund — wie bei Jobs und der Leistungsliste.
     Der Inhalt darunter liegt in Panels, genau wie auf der Startseite. */
  .kopfteil { padding-block: 0; }
  .kopfteil h1 { max-width: 18ch; }

  .flaechenart {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--s-4);
  }
  .marke-farbe {
    width: 0.6875rem;
    height: 0.6875rem;
    border-radius: 2px;
    background: var(--linie-2);
    flex: none;
  }
  .n-buero .marke-farbe { background: var(--nutz-buero); }
  .n-verkehr .marke-farbe { background: var(--nutz-verkehr); }
  .n-sanitaer .marke-farbe { background: var(--nutz-sanitaer); }
  .n-glas .marke-farbe { background: var(--nutz-glas); }
  .n-technik .marke-farbe { background: var(--nutz-technik); }

  .kopfteil h1 { margin-bottom: var(--s-4); }
  .aktionen { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }

  .eckdaten {
    display: grid;
    gap: 1px;
    margin: 0;
    background: var(--linie);
    border: 1px solid var(--linie);
    border-radius: var(--r-klein);
    overflow: hidden;
  }
  .eckdaten > div { background: var(--panel-2); padding: 0.75rem 0.9375rem; }
  .eckdaten dt { margin-bottom: 0.1875rem; }
  .eckdaten dd { margin: 0; color: var(--ink); }

  /* Block 1 — links der Text, rechts Bild und Eckdaten. */
  .umfang-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: start;
  }
  .beiwerk { display: grid; gap: var(--s-4); }

  .einstieg { font-size: 1.125rem; line-height: 1.6; color: var(--ink); }
  .fliesstext h2 { font-size: 1.375rem; margin: var(--s-7) 0 var(--s-4); }
  .fliesstext p { color: var(--ink-2); }

  .umfang { list-style: none; display: grid; gap: 0.625rem; }
  .umfang li {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: 0.5rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .umfang li::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.45rem;
    border: 1.5px solid var(--blau);
    border-radius: 1px;
  }

  .fuer { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4375rem; }
  .fuer li {
    padding: 0.3125rem 0.625rem;
    background: var(--panel-2);
    border: 1px solid var(--linie);
    border-radius: var(--r-pill);
    color: var(--ink-2);
  }

  .bildblock { margin: 0; }
  .bildblock :global(img) {
    width: 100%;
    height: clamp(13rem, 10rem + 10vw, 17rem);
    object-fit: cover;
    border-radius: var(--r-karte);
  }

  /* Block 2 — zwei gleichrangige Themen nebeneinander, ohne Kasten im Kasten. */
  .doppel-panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: start;
  }
  .doppel-panel h2 { font-size: 1.375rem; margin-bottom: var(--s-4); }
  .doppel-panel p { margin: 0; color: var(--ink-2); }

  /* Block 3 — Kopfzeile und Kartenraster wie im Leistungsblock der Startseite. */
  .panel-kopf {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--s-5);
    margin-bottom: clamp(1.75rem, 1.25rem + 2vw, 2.75rem);
  }
  .panel-kopf .label { display: block; margin-bottom: var(--s-3); }
  .panel-kopf h2 { margin: 0; }
  .panel-kopf .btn { flex: none; }

  .leistungsraster {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
  }

  @media (max-width: 68rem) {
    .leistungsraster { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 62rem) {
    .umfang-panel { grid-template-columns: 1fr; }
    .doppel-panel { grid-template-columns: 1fr; }
  }
  @media (max-width: 48rem) {
    .panel-kopf { flex-direction: column; align-items: start; }
  }
  @media (max-width: 40rem) {
    .leistungsraster { grid-template-columns: 1fr; }
  }
</style>
