---
import Base from '../layouts/Base.astro';
import ContactBand from '../components/ContactBand.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../data/site';
import { faq } from '../data/faq';

const beschreibung =
  'Häufige Fragen zur Gebäudereinigung bei CleanCare: Kosten, Ablauf, Besichtigung, Einsatzgebiet, Objektarten und Hygieneartikelservice.';

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.frage,
      acceptedAnswer: { '@type': 'Answer', text: f.antwort },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Fragen', item: `${site.url}/faq` },
    ],
  },
];
---

<Base title="Häufige Fragen" description={beschreibung}>
  <JsonLd slot="head" daten={ld} />

  <section class="kopfteil">
    <div class="wrap">
      <h1>Fragen, die vor jedem Angebot kommen</h1>
      <p class="lead">
        Wir beantworten sie hier, damit im Gespräch Zeit für Ihr Objekt bleibt.
      </p>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap fragen">
      {faq.map((f, i) => (
        <details name="faq" open={i === 0}>
          <summary>
            <span class="mass nr">{String(i + 1).padStart(2, '0')}</span>
            <span class="frage">{f.frage}</span>
            <span class="kreuz" aria-hidden="true"></span>
          </summary>
          <div class="antwort">
            <p>{f.antwort}</p>
          </div>
        </details>
      ))}

      <div class="offen">
        <h2>Etwas anderes im Kopf?</h2>
        <p>
          Rufen Sie an unter <a href={`tel:${site.telefonLink}`} class="mass">{site.telefon}</a> —
          oder schreiben Sie an <a href={`mailto:${site.email}`} class="mass">{site.email}</a>.
        </p>
      </div>
    </div>
  </section>

  <ContactBand
    titel="Die letzte Frage klärt sich vor Ort."
    text="Bei der Besichtigung sehen wir, was ein Angebot wirklich braucht. Das Angebot selbst ist kostenlos und unverbindlich."
  />
</Base>

<style>
  .kopfteil {
    padding-block: 0;
  }
  .kopfteil h1 { margin-bottom: var(--s-4); max-width: 20ch; }

  .fragen { max-width: 52rem; }

  details {
    background: var(--panel);
    border: 1px solid var(--linie);
    border-radius: var(--r-karte);
    margin-bottom: var(--s-3);
    transition: border-color 0.15s var(--ease), box-shadow 0.2s var(--ease);
  }
  details[open] { border-color: var(--linie-2); box-shadow: var(--schwebe-1); }
  details:hover { border-color: var(--linie-2); }

  summary {
    display: grid;
    grid-template-columns: 2.25rem 1fr 1.25rem;
    align-items: baseline;
    gap: var(--s-3);
    padding: 1.0625rem 1.25rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 3px solid var(--blau); outline-offset: -3px; border-radius: var(--r-klein); }

  .nr { color: var(--ink-3); }
  .frage {
    font-size: 1.0625rem;
    font-variation-settings: 'wght' 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }

  .kreuz {
    position: relative;
    width: 0.875rem;
    height: 0.875rem;
    align-self: center;
    justify-self: end;
  }
  .kreuz::before, .kreuz::after {
    content: '';
    position: absolute;
    background: var(--ink-2);
    transition: transform 0.22s var(--ease), opacity 0.22s var(--ease);
  }
  .kreuz::before { inset: 45% 0 45% 0; }
  .kreuz::after { inset: 0 45% 0 45%; }
  details[open] .kreuz::after { transform: scaleY(0); opacity: 0; }

  .antwort {
    padding: 0 1.25rem 1.25rem calc(2.25rem + var(--s-3) + 1.25rem);
  }
  .antwort p { margin: 0; color: var(--ink-2); }

  .offen {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--linie);
  }
  .offen h2 { font-size: 1.25rem; margin-bottom: var(--s-3); }
  .offen a { color: var(--blau); }

  @media (max-width: 40rem) {
    summary { grid-template-columns: 1.75rem 1fr 1rem; padding: 0.9375rem 1rem; }
    .antwort { padding-left: calc(1.75rem + var(--s-3) + 1rem); padding-right: 1rem; }
  }
</style>
