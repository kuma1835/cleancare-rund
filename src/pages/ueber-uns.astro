---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Stimmen from '../components/Stimmen.astro';
import ContactBand from '../components/ContactBand.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../data/site';
import buero from '../assets/img/ron-mcclenny-9yi8eq9mdvy-unsplash.webp';
import team from '../assets/img/redd-f-5u_28ojjgms-unsplash.webp';

const beschreibung =
  'CleanCare Gebäudeservice: Familienbetrieb in zweiter Generation seit 2009, spezialisiert auf Unterhaltsreinigung gewerblicher Immobilien in und um Seevetal.';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Über CleanCare',
  url: `${site.url}/ueber-uns`,
  mainEntity: { '@id': `${site.url}/#unternehmen` },
};
---

<Base title="Über uns: Familienbetrieb seit 2009" description={beschreibung}>
  <JsonLd slot="head" daten={ld} />

  <section class="kopfteil">
    <div class="wrap mitte">
      <p class="label">Über CleanCare</p>
      <h1>Ihre Reinigungsexperten</h1>
      {/* Trägt bewusst nur das Was und Wo. Die Herkunft steht in der Überschrift
          darunter, die Arbeitsweise im Absatz daneben — sonst sagen alle drei
          Stellen dasselbe. */}
      <p class="lead">
        Unterhaltsreinigung für gewerblich genutzte Objekte in Seevetal, im Landkreis Harburg und
        in Hamburg.
      </p>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="panel raster umgekehrt">
        <figure class="bild">
          <Image
            src={buero}
            alt="Ruhige Büroecke mit Schreibtischstuhl, Pflanzen und Tageslicht"
            widths={[420, 700, 1000]}
            sizes="(max-width: 62rem) 100vw, 24rem"
            loading="lazy"
          />
        </figure>
        <div class="text">
          <p class="label">Das Unternehmen</p>
          <h2>Seit {site.gruendung} in Familienhand. Heute in zweiter Generation.</h2>
          <p>
            Traditionelle Werte, verbunden mit modernem Innovationsgeist: Wir verknüpfen die
            Erfahrung aus dieser Zeit mit Digitalisierung und Nachhaltigkeit. Das macht unsere
            Prozesse effektiver — und für Sie heißt das transparente Budgetplanung und
            zuverlässige Qualitätskontrollen.
          </p>
          <p>
            Damit Sie sich zurücklehnen und ganz auf Ihr Kerngeschäft konzentrieren können.
          </p>
          <p class="signatur mass">{site.geschaeftsfuehrung}, Geschäftsführerin</p>
        </div>
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="panel">
        <div class="panel-kopf">
          <div>
            <p class="label">Anspruch</p>
            <h2>Woran wir uns messen lassen</h2>
          </div>
        </div>
        <div class="werteraster">
          <article>
            <span class="wert-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1" /><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /><path d="m9 14 2 2 4-4" /></svg>
            </span>
            <h3>Individuelle Lösungen</h3>
            <p>
              Kein Objekt wie das andere. Das Konzept entsteht aus Ihren Flächen und Ihrem Betrieb,
              nicht aus einem Standardpaket.
            </p>
          </article>
          <article>
            <span class="wert-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="m9 12 2 2 4-4" /></svg>
            </span>
            <h3>Verlässliche Qualität</h3>
            <p>
              Feste Teams, wiederkehrende Abläufe, kontrollierte Ergebnisse. Wer das Objekt kennt,
              übersieht weniger.
            </p>
          </article>
          <article>
            <span class="wert-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9.94 15.5A2 2 0 0 0 8.5 14.06l-6.14-1.58a.5.5 0 0 1 0-.96L8.5 9.94A2 2 0 0 0 9.94 8.5l1.58-6.14a.5.5 0 0 1 .96 0L14.06 8.5A2 2 0 0 0 15.5 9.94l6.14 1.58a.5.5 0 0 1 0 .96L15.5 14.06a2 2 0 0 0-1.44 1.44l-1.58 6.14a.5.5 0 0 1-.96 0z" /><path d="M20 3v4" /><path d="M22 5h-4" /><path d="M4 17v2" /><path d="M5 18H3" /></svg>
            </span>
            <h3>Persönlicher Service</h3>
            <p>
              Kurze Wege zur Geschäftsführung statt Ticketsystem. Rückmeldungen landen dort, wo
              entschieden wird.
            </p>
          </article>
          <article>
            <span class="wert-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" /><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" /></svg>
            </span>
            <h3>Nachhaltige Vision</h3>
            <p>
              Digitalisierung und verantwortungsvolle Prozesse gehören für uns zusammen — sie machen
              Reinigung planbarer und sparsamer.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="panel raster umgekehrt">
        <figure class="bild">
          <Image
            src={team}
            alt="Besprechung an einem langen Tisch, gesehen durch eine Glaswand"
            widths={[420, 700, 1000]}
            sizes="(max-width: 62rem) 100vw, 24rem"
            loading="lazy"
          />
        </figure>
        <div class="text">
          <p class="label">Nähe</p>
          <h2>Ein Betrieb, den man erreicht</h2>
          <p>
            CleanCare sitzt in {site.ort}, südlich von Hamburg. Von dort betreuen wir Objekte im
            Landkreis Harburg, in Hamburg und darüber hinaus in Niedersachsen und
            Schleswig-Holstein.
          </p>
          <p>
            Der Vorteil eines Familienbetriebs zeigt sich im Alltag: kurze Entscheidungswege, feste
            Ansprechpartner und die Bereitschaft, ein Objekt auch dann noch persönlich anzusehen,
            wenn es längst läuft.
          </p>
          <ul class="gebiet">
            {site.gebiet.map((g) => <li class="mass">{g}</li>)}
          </ul>
          <a class="btn btn-3" href="/einsatzgebiet">Einsatzgebiet ansehen</a>
        </div>
      </div>
    </div>
  </section>

  <Stimmen />
  <ContactBand />
</Base>

<style>
  /* Abschnittsmarke über der Überschrift. `.mitte` zentriert seine Kinder
     bereits; die Höchstbreite aus `p` wird hier aufgehoben, damit die Box die
     volle Breite hat und ihr Text wirklich in der Mitte steht. */
  .mitte > .label { display: block; margin-bottom: var(--s-3); max-width: none; }

  .kopfteil {
    padding-block: 0;
  }
  .kopfteil h1 { margin-bottom: var(--s-4); }

  /* Text und Beiwerk nebeneinander im Panel — dieselbe Aufteilung wie auf den
     Leistungs-Detailseiten, damit beide Seiten gleich gelesen werden. */
  .raster {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: start;
  }
  .umgekehrt {
    grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
    align-items: center;
  }

  .text .label { display: block; margin-bottom: var(--s-3); }
  /* Ohne :not() würde diese Regel die Abschnittsmarke übertönen — sie ist
     ebenfalls ein <p> und soll dunkelblau bleiben. */
  .text p:not(.label) { color: var(--ink-2); }
  /* Die Aussage über dem Fließtext ist eine echte Überschrift — dieselbe
     Formatierung wie im Block „Ein Betrieb, den man erreicht". */
  .text h2 { margin-bottom: var(--s-5); }
  .signatur { color: var(--ink); margin-top: var(--s-5); }
  .signatur::before { content: '— '; }

  /* Das Bild steht allein in seiner Spalte — der frühere Eckdatenkasten darunter
     ist entfallen, damit es die volle Höhe des Blocks bekommt. */
  .bild { margin: 0; align-self: stretch; }
  .bild :global(img) {
    width: 100%;
    height: 100%;
    min-height: clamp(15rem, 11rem + 13vw, 21rem);
    object-fit: cover;
    border-radius: var(--r-karte);
  }

  .panel-kopf {
    margin-bottom: clamp(2.25rem, 1.75rem + 2vw, 3.5rem);
    text-align: center;
  }
  /* Wie bei den übrigen Abschnittsmarken: die Box der Marke selbst zentrieren,
     sonst sitzt sie durch die 68ch aus base.css links im Container. */
  .panel-kopf .label { display: block; margin: 0 auto var(--s-3); max-width: none; }
  .panel-kopf h2 { margin: 0 auto; max-width: 24ch; }

  /* Je ein gezeichnetes Symbol über der Aussage — Bildzeichen nach der vom
     Nutzer gesetzten Referenz (Klemmbrett, Schild, Funken, Blatt). */
  .wert-icon {
    display: inline-flex;
    color: var(--blau);
    margin-bottom: var(--s-4);
  }

  /* Vier gleichrangige Aussagen — als Karten statt als Textspalten mit Oberkante,
     damit sie zum Kartenbild der übrigen Seiten passen. */
  .werteraster {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .werteraster article {
    padding: var(--s-5);
    background: var(--panel-2);
    border: 1px solid var(--linie);
    border-radius: var(--r-karte);
  }
  .werteraster h3 { margin-bottom: var(--s-3); }
  .werteraster p { margin: 0; font-size: 0.9375rem; color: var(--ink-2); line-height: 1.6; }

  .gebiet {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4375rem;
    margin-top: var(--s-5);
  }
  .gebiet li {
    padding: 0.3125rem 0.625rem;
    background: var(--panel-2);
    border: 1px solid var(--linie);
    border-radius: var(--r-pill);
    color: var(--ink-2);
  }

  .umgekehrt .btn { margin-top: var(--s-5); }

  @media (max-width: 68rem) {
    .werteraster { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 62rem) {
    .raster, .umgekehrt { grid-template-columns: 1fr; }
    .umgekehrt .bild { order: 2; }
  }
  @media (max-width: 40rem) {
    .werteraster { grid-template-columns: 1fr; }
  }
</style>
