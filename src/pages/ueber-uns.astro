---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Stimmen from '../components/Stimmen.astro';
import ContactBand from '../components/ContactBand.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../data/site';
import buero from '../assets/img/ron-mcclenny-9yi8eq9mdvy-unsplash.webp';
import team from '../assets/img/redd-f-5u_28ojjgms-unsplash.webp';

const beschreibung =
  'CleanCare Gebäudeservice GmbH: Familienunternehmen in zweiter Generation seit 2009, spezialisiert auf ganzheitliche Unterhaltsreinigung gewerblich genutzter Immobilien.';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Über CleanCare',
  url: `${site.url}/ueber-uns`,
  mainEntity: { '@id': `${site.url}/#unternehmen` },
};
---

<Base title="Über uns" description={beschreibung}>
  <JsonLd slot="head" daten={ld} />

  <section class="kopfteil">
    <div class="wrap">
      <h1>Ihre Reinigungsexperten</h1>
      <p class="lead">
        Traditionelle Werte in Verbindung mit modernem Innovationsgeist — seit {site.gruendung}, in
        zweiter Generation.
      </p>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="panel raster">
        <div class="text">
          <p class="label">Das Unternehmen</p>
          <p class="einstieg">
            Seit {site.gruendung} reinigen wir gewerblich genutzte Immobilien — als
            Familienunternehmen, heute in zweiter Generation.
          </p>
          <p>
            Traditionelle Werte, verbunden mit modernem Innovationsgeist: Wir verknüpfen die
            Erfahrung aus dieser Zeit mit Digitalisierung und Nachhaltigkeit. Das macht unsere
            Prozesse effektiver — und für Sie heißt das transparente Budgetplanung und
            zuverlässige Qualitätskontrollen.
          </p>
          <p>
            Damit Sie sich zurücklehnen und ganz auf Ihr Kerngeschäft konzentrieren können.
          </p>
          <p class="signatur mass">{site.geschaeftsfuehrung}, Geschäftsführerin</p>
        </div>

        <div class="beiwerk">
          <figure class="bild">
            <Image
              src={buero}
              alt="Ruhige Büroecke mit Schreibtischstuhl, Pflanzen und Tageslicht"
              widths={[420, 700, 1000]}
              sizes="(max-width: 62rem) 100vw, 24rem"
              loading="lazy"
            />
          </figure>
          <dl class="eckdaten">
            <div>
              <dt class="feld">Gegründet</dt>
              <dd class="mass">{site.gruendung}, zweite Generation</dd>
            </div>
            <div>
              <dt class="feld">Sitz</dt>
              <dd class="mass">{site.strasse}, {site.plz} {site.ort}</dd>
            </div>
            <div>
              <dt class="feld">Geschäftsführung</dt>
              <dd class="mass">{site.geschaeftsfuehrung}</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="panel">
        <div class="panel-kopf">
          <div>
            <p class="label">Anspruch</p>
            <h2>Woran wir uns messen lassen</h2>
          </div>
        </div>
        <div class="werteraster">
          <article>
            <h3>Individuelle Lösungen</h3>
            <p>
              Kein Objekt wie das andere. Das Konzept entsteht aus Ihren Flächen und Ihrem Betrieb,
              nicht aus einem Standardpaket.
            </p>
          </article>
          <article>
            <h3>Verlässliche Qualität</h3>
            <p>
              Feste Teams, wiederkehrende Abläufe, kontrollierte Ergebnisse. Wer das Objekt kennt,
              übersieht weniger.
            </p>
          </article>
          <article>
            <h3>Persönlicher Service</h3>
            <p>
              Kurze Wege zur Geschäftsführung statt Ticketsystem. Rückmeldungen landen dort, wo
              entschieden wird.
            </p>
          </article>
          <article>
            <h3>Nachhaltige Vision</h3>
            <p>
              Digitalisierung und verantwortungsvolle Prozesse gehören für uns zusammen — sie machen
              Reinigung planbarer und sparsamer.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap">
      <div class="panel raster umgekehrt">
        <figure class="bild">
          <Image
            src={team}
            alt="Besprechung an einem langen Tisch, gesehen durch eine Glaswand"
            widths={[420, 700, 1000]}
            sizes="(max-width: 62rem) 100vw, 24rem"
            loading="lazy"
          />
        </figure>
        <div class="text">
          <p class="label">Nähe</p>
          <h2>Ein Betrieb, den man erreicht</h2>
          <p>
            CleanCare sitzt in {site.ort}, südlich von Hamburg. Von dort betreuen wir Objekte im
            Landkreis Harburg, in Hamburg und darüber hinaus in Niedersachsen und
            Schleswig-Holstein.
          </p>
          <p>
            Der Vorteil eines Familienbetriebs zeigt sich im Alltag: kurze Entscheidungswege, feste
            Ansprechpartner und die Bereitschaft, ein Objekt auch dann noch persönlich anzusehen,
            wenn es längst läuft.
          </p>
          <ul class="gebiet">
            {site.gebiet.map((g) => <li class="mass">{g}</li>)}
          </ul>
          <a class="btn btn-3" href="/einsatzgebiet">Einsatzgebiet ansehen</a>
        </div>
      </div>
    </div>
  </section>

  <Stimmen />
  <ContactBand />
</Base>

<style>
  .kopfteil {
    padding-block: 0;
  }
  .kopfteil h1 { margin-bottom: var(--s-4); }

  /* Text und Beiwerk nebeneinander im Panel — dieselbe Aufteilung wie auf den
     Leistungs-Detailseiten, damit beide Seiten gleich gelesen werden. */
  .raster {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: start;
  }
  .umgekehrt {
    grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
    align-items: center;
  }

  .text .label { display: block; margin-bottom: var(--s-3); }
  .einstieg { font-size: 1.1875rem; line-height: 1.55; color: var(--ink); }
  .text p { color: var(--ink-2); }
  .text h2 { margin-bottom: var(--s-4); }
  .signatur { color: var(--ink); margin-top: var(--s-5); }
  .signatur::before { content: '— '; }

  .beiwerk { display: grid; gap: var(--s-4); }

  .bild { margin: 0; }
  .bild :global(img) {
    width: 100%;
    height: clamp(13rem, 10rem + 10vw, 17rem);
    object-fit: cover;
    border-radius: var(--r-karte);
  }
  .umgekehrt .bild :global(img) { height: clamp(15rem, 11rem + 13vw, 21rem); }

  .eckdaten {
    display: grid;
    gap: 1px;
    margin: 0;
    background: var(--linie);
    border: 1px solid var(--linie);
    border-radius: var(--r-klein);
    overflow: hidden;
  }
  .eckdaten > div { background: var(--panel-2); padding: 0.75rem 0.9375rem; }
  .eckdaten dt { margin-bottom: 0.1875rem; }
  .eckdaten dd { margin: 0; color: var(--ink); }

  .panel-kopf { margin-bottom: clamp(1.75rem, 1.25rem + 2vw, 2.75rem); }
  .panel-kopf .label { display: block; margin-bottom: var(--s-3); }
  .panel-kopf h2 { margin: 0; }

  /* Vier gleichrangige Aussagen — als Karten statt als Textspalten mit Oberkante,
     damit sie zum Kartenbild der übrigen Seiten passen. */
  .werteraster {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .werteraster article {
    padding: var(--s-5);
    background: var(--panel-2);
    border: 1px solid var(--linie);
    border-radius: var(--r-karte);
  }
  .werteraster h3 { margin-bottom: var(--s-3); }
  .werteraster p { margin: 0; font-size: 0.9375rem; color: var(--ink-2); line-height: 1.6; }

  .gebiet {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4375rem;
    margin-top: var(--s-5);
  }
  .gebiet li {
    padding: 0.3125rem 0.625rem;
    background: var(--panel-2);
    border: 1px solid var(--linie);
    border-radius: var(--r-pill);
    color: var(--ink-2);
  }

  .umgekehrt .btn { margin-top: var(--s-5); }

  @media (max-width: 68rem) {
    .werteraster { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 62rem) {
    .raster, .umgekehrt { grid-template-columns: 1fr; }
    .umgekehrt .bild { order: 2; }
  }
  @media (max-width: 40rem) {
    .werteraster { grid-template-columns: 1fr; }
  }
</style>
