---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base
  title="AGB"
  description="Allgemeine Geschäftsbedingungen der CleanCare Gebäudeservice GmbH."
  noindex={true}
>
  <section class="rechtstext">
    <div class="wrap">
      <h1>Allgemeine Geschäftsbedingungen</h1>

      <div class="entwurf">
        <p class="feld">Redaktionshinweis</p>
        <p>
          Die geltenden AGB liegen bei CleanCare vor und werden vor Livegang unverändert
          übernommen. Ein erfundener Text hätte hier nichts verloren — deshalb steht hier keiner.
        </p>
      </div>

      <p>
        Bis dahin gilt: Für Angebote, Verträge und Leistungen der {site.name} sind die dem
        jeweiligen Angebot beigefügten Bedingungen maßgeblich. Fragen dazu beantworten wir gern
        unter <a href={`mailto:${site.email}`}>{site.email}</a> oder
        <a href={`tel:${site.telefonLink}`}>{site.telefon}</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .rechtstext { padding-block: 0; }
  .rechtstext h1 { margin-bottom: var(--s-6); }
  .rechtstext p { color: var(--ink-2); line-height: 1.65; }
  .rechtstext a { color: var(--blau); }

  .entwurf {
    padding: var(--s-4) var(--s-5);
    background: var(--panel-2);
    border: 1px dashed var(--linie-2);
    border-radius: var(--r-karte);
    margin-bottom: var(--s-6);
  }
  .entwurf .feld { margin-bottom: 0.5rem; color: var(--warn); }
  .entwurf p { margin: 0; font-size: 0.9375rem; }
</style>
